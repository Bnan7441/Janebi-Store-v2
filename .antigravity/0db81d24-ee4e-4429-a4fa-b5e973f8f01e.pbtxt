\331\207\330\247\333\214 \331\201\330\271\331\204\333\214:**\n   \330\252\331\205\330\247\331\205\333\214 \330\250\330\256\330\264\342\200\214\331\207\330\247\333\214 \331\201\330\261\331\210\330\264\332\257\330\247\331\207 \332\251\330\247\331\205\331\204\330\214 \331\201\330\271\330\247\331\204\330\214 \330\250\330\257\331\210\331\206 \330\256\330\267\330\247 \331\210 \330\257\330\247\330\261\330\247\333\214 \330\271\331\205\331\204\332\251\330\261\330\257 \331\205\331\206\330\267\331\202\333\214 \331\210 \333\214\332\251\331\276\330\247\330\261\332\206\331\207 \331\207\330\263\330\252\331\206\330\257.\n\n---\n*\330\252\330\243\332\251\333\214\330\257 \331\205\330\254\330\257\330\257: \330\247\333\214\331\206 \332\257\330\262\330\247\330\261\330\264 \330\250\330\257\331\210\331\206 \330\247\333\214\330\254\330\247\330\257\330\214 \330\255\330\260\331\201 \333\214\330\247 \331\210\333\214\330\261\330\247\333\214\330\264 \331\207\333\214\332\206 \332\251\330\257\333\214 \330\252\331\206\330\270\333\214\331\205 \330\264\330\257\331\207 \331\210 \331\201\331\202\330\267 \330\250\330\247\330\262\330\252\330\247\330\250\342\200\214\330\257\331\207\331\206\330\257\331\207 \330\263\330\247\330\256\330\252\330\247\330\261 \330\257\331\202\333\214\331\202 \331\210 \331\205\331\210\330\254\331\210\330\257 \331\276\330\261\331\210\332\230\331\207 \331\205\333\214\342\200\214\330\250\330\247\330\264\330\257.*"
