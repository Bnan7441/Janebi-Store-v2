      target_content: "import React from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { Trash2, ShoppingBag, Truck, CreditCard, User, ShoppingCart } from \'lucide-react\';\nimport { useCart } from \'../contexts/CartContext\';\nimport EmptyState from \'../components/EmptyState\';\nimport { motion } from \'motion/react\';\n\nexport default function Cart() {\n  const { cart, removeFromCart, updateQuantity, clearCart, cartTotal } = useCart();\n\n  if (cart.length === 0) {\n    return (\n      <motion.div\n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.5, ease: \"easeOut\" }}\n      >\n        <EmptyState \n          icon={<ShoppingCart className=\"h-16 w-16 text-gray-300\" />}\n          title=\"\330\263\330\250\330\257 \330\256\330\261\333\214\330\257 \330\264\331\205\330\247 \330\256\330\247\331\204\333\214 \330\247\330\263\330\252!\"\n          description=\"\331\205\333\214\342\200\214\330\252\331\210\330\247\331\206\333\214\330\257 \330\250\330\261\330\247\333\214 \331\205\330\264\330\247\331\207\330\257\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252 \331\210 \330\247\330\266\330\247\331\201\331\207 \332\251\330\261\330\257\331\206 \330\242\331\206\342\200\214\331\207\330\247 \330\250\331\207 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257\330\214 \330\250\331\207 \330\265\331\201\330\255\331\207 \331\201\330\261\331\210\330\264\332\257\330\247\331\207 \330\263\330\261 \330\250\330\262\331\206\333\214\330\257.\"\n          actionText=\"\331\205\330\264\330\247\331\207\330\257\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\"\n          actionLink=\"/products\"\n        />\n      </motion.div>\n    );\n  }\n\n  return (\n    <motion.div \n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ duration: 0.5, ease: \"easeOut\" }}\n      className=\"bg-white rounded-3xl p-6 lg:p-10 shadow-sm border border-gray-100\"\n    >\n       {/* Breadcrumb */}\n       \n\n      <div className=\"flex items-center justify-between mb-8\">\n        <h1 className=\"text-3xl font-black text-gray-900 mt-4\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257 \330\264\331\205\330\247</h1>\n      </div>\n\n      {/* Stepper */}\n      <div className=\"flex items-center justify-between max-w-2xl mx-auto mb-12 relative\">\n         <div className=\"absolute top-1/2 left-0 right-0 h-1 bg-gray-200 -z-10 -translate-y-1/2\"></div>\n         \n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-orange-600 text-white flex items-center justify-center font-bold\">\333\261</div>\n           <span className=\"text-sm font-bold text-orange-600\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257</span>\n         </div>\n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold\">\333\262</div>\n           <span className=\"text-sm font-medium text-gray-500\">\330\247\330\267\331\204\330\247\330\271\330\247\330\252 \330\247\330\261\330\263\330\247\331\204</span>\n         </div>\n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold\">\333\263</div>\n           <span className=\"text-sm font-medium text-gray-500\">\331\276\330\261\330\257\330\247\330\256\330\252</span>\n         </div>\n      </div>\n\n      <div className=\"flex flex-col lg:flex-row gap-8\">\n        {/* Cart Items */}\n        <div className=\"w-full lg:w-2/3\">\n           <div className=\"border border-gray-200 rounded-2xl overflow-hidden\">\n             <table className=\"w-full text-right\">\n               <thead className=\"bg-gray-50 text-gray-500 text-sm border-b border-gray-200 hidden md:table-header-group\">\n                 <tr>\n                   <th className=\"py-4 px-6 font-medium\">\331\205\330\255\330\265\331\210\331\204</th>\n                   <th className=\"py-4 px-6 font-medium text-center\">\331\202\333\214\331\205\330\252 \331\210\330\247\330\255\330\257</th>\n                   <th className=\"py-4 px-6 font-medium text-center\">\330\252\330\271\330\257\330\247\330\257</th>\n                   <th className=\"py-4 px-6 font-medium text-left\">\331\205\330\254\331\205\331\210\330\271</th>\n                   <th className=\"py-4 px-6\"></th>\n                 </tr>\n               </thead>\n               <tbody className=\"divide-y divide-gray-100 block md:table-row-group\">\n                 {cart.map(item => (\n                   <tr key={item.id} className=\"block md:table-row p-4 md:p-0\">\n                      <td className=\"py-4 md:py-6 px-2 md:px-6 flex items-center gap-4 border-b md:border-0 border-gray-100\">\n                        <div className=\"w-20 h-20 bg-gray-50 rounded-xl flex items-center justify-center shrink-0\">\n                           <img src={item.image} alt={item.title} className=\"w-16 h-16 object-contain mix-blend-multiply\" />\n                        </div>\n                        <div>\n                          <h4 className=\"font-bold text-gray-900 mb-1\">{item.title}</h4>\n                          <div className=\"text-xs text-gray-500 space-y-1\">\n                            <p>\330\250\330\261\331\206\330\257: {item.brand}</p>\n                            {item.warranty && <p>\332\257\330\247\330\261\330\247\331\206\330\252\333\214: {item.warranty}</p>}\n                          </div>\n                        </div>\n                      </td>\n                      <td className=\"py-2 md:py-6 px-2 md:px-6 text-center text-gray-800 font-medium block md:table-cell before:content-[\'\331\202\333\214\331\205\330\252_\331\210\330\247\330\255\330\257:\'] md:before:content-none before:ml-2 before:text-gray-500 flex md:block justify-between items-center\">\n                        {item.price.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206\n                      </td>\n                      <td className=\"py-2 md:py-6 px-2 md:px-6 block md:table-cell border-b md:border-0 border-gray-100 flex md:block justify-between items-center before:content-[\'\330\252\330\271\330\257\330\247\330\257:\'] md:before:content-none before:ml-2 before:text-gray-500\">\n                        <div className=\"flex items-center justify-center border border-gray-200 rounded-lg w-24 mx-auto\">\n                          <button onClick={() => updateQuantity(item.id, item.quantity + 1)} className=\"px-3 py-2 text-gray-500 hover:text-orange-600\">+</button>\n                          <span className=\"px-2 font-medium\">{item.quantity.toLocaleString(\'fa-IR\')}</span>\n                          <button onClick={() => updateQuantity(item.id, item.quantity - 1)} className=\"px-3 py-2 text-gray-500 hover:text-orange-600\">-</button>\n                        </div>\n                      </td>\n                      <td className=\"py-4 md:py-6 px-2 md:px-6 text-left font-bold text-orange-600 block md:table-cell flex md:block justify-between items-center before:content-[\'\331\205\330\254\331\205\331\210\330\271:\'] md:before:content-none before:ml-2 before:text-gray-500\">\n                        {(item.price * item.quantity).toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206\n                      </td>\n                      <td className=\"py-2 md:py-6 px-2 md:px-6 text-left block md:table-cell\">\n                         <button onClick={() => removeFromCart(item.id)} className=\"text-gray-400 hover:text-red-500 p-2 w-full md:w-auto text-center\"><Trash2 className=\"h-5 w-5 mx-auto\" /></button>\n                      </td>\n                   </tr>\n                 ))}\n               </tbody>\n             </table>\n           </div>\n           \n           <div className=\"mt-6 flex justify-start\">\n             <button onClick={clearCart} className=\"flex items-center gap-2 text-red-500 text-sm font-medium hover:text-red-600\">\n               <Trash2 className=\"h-4 w-4\" /> \331\276\330\247\332\251 \332\251\330\261\330\257\331\206 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257\n             </button>\n           </div>\n        </div>\n\n        {/* Order Summary */}\n        <div className=\"w-full lg:w-1/3\">\n           <div className=\"bg-gray-50 rounded-2xl p-6 border border-gray-200 sticky top-28\">\n             <h3 className=\"font-black text-gray-900 text-xl mb-6\">\330\256\331\204\330\247\330\265\331\207 \330\263\331\201\330\247\330\261\330\264</h3>\n             \n             <div className=\"space-y-4 mb-6 text-sm\">\n               <div className=\"flex justify-between text-gray-600\">\n                 <span>\330\254\331\205\330\271 \332\251\331\204 \332\251\330\247\331\204\330\247\331\207\330\247</span>\n                 <span className=\"font-medium text-gray-900\">{cartTotal.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206</span>\n               </div>\n               <div className=\"flex justify-between text-gray-600\">\n                 <span>\330\252\330\256\331\201\333\214\331\201</span>\n                 <span className=\"text-red-500 font-medium\">\333\260 \330\252\331\210\331\205\330\247\331\206</span>\n               </div>\n               <div className=\"flex justify-between text-gray-600\">\n                 <span>\331\207\330\262\333\214\331\206\331\207 \330\247\330\261\330\263\330\247\331\204</span>\n                 <span className=\"text-gray-400 text-xs\">\330\257\330\261 \331\205\330\261\330\255\331\204\331\207 \330\250\330\271\330\257 \331\205\330\255\330\247\330\263\330\250\331\207 \331\205\333\214\342\200\214\330\264\331\210\330\257</span>\n               </div>\n             </div>\n             \n             <div className=\"border-t border-gray-200 pt-6 mb-6\">\n               <div className=\"flex justify-between items-center mb-2\">\n                 <span className=\"font-bold text-gray-900\">\331\205\330\250\331\204\330\272 \331\202\330\247\330\250\331\204 \331\276\330\261\330\257\330\247\330\256\330\252</span>\n                 <span className=\"text-2xl font-black text-orange-600\">{cartTotal.toLocaleString(\'fa-IR\')} <span className=\"text-sm font-normal text-gray-600\">\330\252\331\210\331\205\330\247\331\206</span></span>\n               </div>\n             </div>\n             \n             <Link to=\"/checkout\" className=\"block w-full bg-orange-600 hover:bg-orange-700 text-white text-center font-bold py-4 rounded-xl transition-colors mb-4\">\n               \330\247\330\257\330\247\331\205\331\207 \331\201\330\261\330\247\333\214\331\206\330\257 \330\256\330\261\333\214\330\257\n             </Link>\n             \n             <div className=\"text-center text-xs text-gray-500 flex flex-col items-center gap-2\">\n               <span className=\"flex items-center gap-1\"><User className=\"h-4 w-4 inline\" /> \330\247\331\205\332\251\330\247\331\206 \330\256\330\261\333\214\330\257 \330\250\330\257\331\210\331\206 \330\271\330\266\331\210\333\214\330\252</span>\n             </div>\n           </div>\n        </div>\n      </div>\n    </motion.div>\n  );\n}"
      replacement_content: "import React from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { Trash2, ShoppingBag, Truck, CreditCard, User, ShoppingCart, CheckCircle2, Sparkles, ArrowLeft, Gift } from \'lucide-react\';\nimport { useCart } from \'../contexts/CartContext\';\nimport EmptyState from \'../components/EmptyState\';\nimport { motion } from \'motion/react\';\n\nconst FREE_SHIPPING_THRESHOLD = 2000000; // 2,000,000 Toman\n\nexport default function Cart() {\n  const { cart, removeFromCart, updateQuantity, clearCart, cartTotal } = useCart();\n\n  const isFreeShipping = cartTotal >= FREE_SHIPPING_THRESHOLD;\n  const amountLeft = Math.max(0, FREE_SHIPPING_THRESHOLD - cartTotal);\n  const progressPercentage = Math.min(100, Math.round((cartTotal / FREE_SHIPPING_THRESHOLD) * 100));\n\n  if (cart.length === 0) {\n    return (\n      <motion.div\n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.5, ease: \"easeOut\" }}\n      >\n        <EmptyState \n          icon={<ShoppingCart className=\"h-16 w-16 text-gray-300\" />}\n          title=\"\330\263\330\250\330\257 \330\256\330\261\333\214\330\257 \330\264\331\205\330\247 \330\256\330\247\331\204\333\214 \330\247\330\263\330\252!\"\n          description=\"\331\205\333\214\342\200\214\330\252\331\210\330\247\331\206\333\214\330\257 \330\250\330\261\330\247\333\214 \331\205\330\264\330\247\331\207\330\257\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252 \331\210 \330\247\330\266\330\247\331\201\331\207 \332\251\330\261\330\257\331\206 \330\242\331\206\342\200\214\331\207\330\247 \330\250\331\207 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257\330\214 \330\250\331\207 \330\265\331\201\330\255\331\207 \331\201\330\261\331\210\330\264\332\257\330\247\331\207 \330\263\330\261 \330\250\330\262\331\206\333\214\330\257.\"\n          actionText=\"\331\205\330\264\330\247\331\207\330\257\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\"\n          actionLink=\"/products\"\n        />\n      </motion.div>\n    );\n  }\n\n  return (\n    <motion.div \n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ duration: 0.5, ease: \"easeOut\" }}\n      className=\"bg-white rounded-3xl p-6 lg:p-10 shadow-sm border border-gray-100\"\n    >\n       {/* Breadcrumb */}\n\n      <div className=\"flex items-center justify-between mb-8\">\n        <h1 className=\"text-3xl font-black text-gray-900 mt-4\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257 \330\264\331\205\330\247</h1>\n      </div>\n\n      {/* Stepper */}\n      <div className=\"flex items-center justify-between max-w-2xl mx-auto mb-10 relative\">\n         <div className=\"absolute top-1/2 left-0 right-0 h-1 bg-gray-200 -z-10 -translate-y-1/2\"></div>\n         \n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-orange-600 text-white flex items-center justify-center font-bold\">\333\261</div>\n           <span className=\"text-sm font-bold text-orange-600\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257</span>\n         </div>\n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold\">\333\262</div>\n           <span className=\"text-sm font-medium text-gray-500\">\330\247\330\267\331\204\330\247\330\271\330\247\330\252 \330\247\330\261\330\263\330\247\331\204</span>\n         </div>\n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold\">\333\263</div>\n           <span className=\"text-sm font-medium text-gray-500\">\331\276\330\261\330\257\330\247\330\256\330\252</span>\n         </div>\n      </div>\n\n      {/* Free Shipping Progress Bar Card */}\n      <motion.div \n        initial={{ opacity: 0, scale: 0.98 }}\n        animate={{ opacity: 1, scale: 1 }}\n        transition={{ duration: 0.4 }}\n        className={`mb-8 p-5 md:p-6 rounded-2xl border transition-all ${\n          isFreeShipping \n            ? \'bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 border-emerald-200 shadow-sm\' \n            : \'bg-gradient-to-r from-orange-50 via-amber-50 to-orange-50 border-orange-200/80 shadow-sm\'\n        }`}\n      >\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 mb-3\">\n          <div className=\"flex items-center gap-3\">\n            <div className={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 shadow-sm ${\n              isFreeShipping ? \'bg-emerald-500 text-white\' : \'bg-orange-500 text-white\'\n            }`}>\n              {isFreeShipping ? (\n                <CheckCircle2 className=\"h-6 w-6 animate-bounce\" />\n              ) : (\n                <Truck className=\"h-6 w-6\" />\n              )}\n            </div>\n            <div>\n              {isFreeShipping ? (\n                <div>\n                  <h3 className=\"font-bold text-emerald-900 text-base md:text-lg flex items-center gap-2\">\n                    \330\247\330\261\330\263\330\247\331\204 \330\261\330\247\333\214\332\257\330\247\331\206 \330\264\330\247\331\205\331\204 \330\263\331\201\330\247\330\261\330\264 \330\264\331\205\330\247 \330\264\330\257! \360\237\216\211\n                  </h3>\n                  <p className=\"text-xs md:text-sm text-emerald-700 mt-0.5\">\n                    \330\263\331\201\330\247\330\261\330\264 \330\264\331\205\330\247 \330\255\330\257 \331\206\330\265\330\247\330\250 \333\262,\333\260\333\260\333\260,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206 \330\261\330\247 \332\257\330\260\330\261\330\247\331\206\330\257\331\207 \331\210 \330\250\330\257\331\210\331\206 \331\207\330\262\333\214\331\206\331\207 \330\247\330\261\330\263\330\247\331\204 \330\252\330\255\331\210\333\214\331\204 \330\257\330\247\330\257\331\207 \331\205\333\214\342\200\214\330\264\331\210\330\257.\n                  </p>\n                </div>\n              ) : (\n                <div>\n                  <h3 className=\"font-bold text-gray-900 text-base md:text-lg\">\n                    \330\252\331\206\331\207\330\247 <span className=\"text-orange-600 font-black\">{amountLeft.toLocaleString(\'fa-IR\')}</span> \330\252\331\210\331\205\330\247\331\206 \330\257\333\214\332\257\330\261 \330\252\330\247 <span className=\"text-orange-600 font-black\">\330\247\330\261\330\263\330\247\331\204 \330\261\330\247\333\214\332\257\330\247\331\206</span>\n                  </h3>\n                  <p className=\"text-xs md:text-sm text-gray-600 mt-0.5\">\n                    \330\250\330\261\330\247\333\214 \330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \330\250\330\247\331\204\330\247\333\214 \333\262,\333\260\333\260\333\260,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206\330\214 \330\247\330\261\330\263\330\247\331\204 \330\250\331\207 \330\263\330\261\330\247\330\263\330\261 \332\251\330\264\331\210\330\261 \332\251\330\247\331\205\331\204\330\247\331\213 \330\261\330\247\333\214\332\257\330\247\331\206 \330\247\330\263\330\252.\n                  </p>\n                </div>\n              )}\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between md:justify-end gap-3 shrink-0\">\n            <span className={`text-sm font-black px-3 py-1 rounded-full border ${\n              isFreeShipping \n                ? \'bg-emerald-100 text-emerald-800 border-emerald-300\' \n                : \'bg-orange-100 text-orange-800 border-orange-300\'\n            }`}>\n              {progressPercentage.toLocaleString(\'fa-IR\')}\331\252 \330\252\332\251\331\205\333\214\331\204\333\214\n            </span>\n            {!isFreeShipping && (\n              <Link \n                to=\"/products\" \n                className=\"text-xs font-bold text-orange-600 hover:text-orange-700 flex items-center gap-1 hover:underline\"\n              >\n                \330\247\331\201\330\262\331\210\330\257\331\206 \332\251\330\247\331\204\330\247\333\214 \330\250\333\214\330\264\330\252\330\261\n                <ArrowLeft className=\"h-3.5 w-3.5\" />\n              </Link>\n            )}\n          </div>\n        </div>\n\n        {/* Progress Bar Track */}\n        <div className=\"w-full bg-gray-200/80 rounded-full h-3.5 overflow-hidden p-0.5 relative\">\n          <motion.div \n            initial={{ width: 0 }}\n            animate={{ width: `${progressPercentage}%` }}\n            transition={{ duration: 0.6, ease: \"easeOut\" }}\n            className={`h-full rounded-full transition-all relative ${\n              isFreeShipping \n                ? \'bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 shadow-sm\' \n                : \'bg-gradient-to-r from-orange-500 via-amber-500 to-orange-600 shadow-sm\'\n            }`}\n          >\n            {/* Shimmer effect */}\n            <div className=\"absolute inset-0 bg-white/20 rounded-full animate-pulse\"></div>\n          </motion.div>\n        </div>\n      </motion.div>\n\n      <div className=\"flex flex-col lg:flex-row gap-8\">\n        {/* Cart Items */}\n        <div className=\"w-full lg:w-2/3\">\n           <div className=\"border border-gray-200 rounded-2xl overflow-hidden\">\n             <table className=\"w-full text-right\">\n               <thead className=\"bg-gray-50 text-gray-500 text-sm border-b border-gray-200 hidden md:table-header-group\">\n                 <tr>\n                   <th className=\"py-4 px-6 font-medium\">\331\205\330\255\330\265\331\210\331\204</th>\n                   <th className=\"py-4 px-6 font-medium text-center\">\331\202\333\214\331\205\330\252 \331\210\330\247\330\255\330\257</th>\n                   <th className=\"py-4 px-6 font-medium text-center\">\330\252\330\271\330\257\330\247\330\257</th>\n                   <th className=\"py-4 px-6 font-medium text-left\">\331\205\330\254\331\205\331\210\330\271</th>\n                   <th className=\"py-4 px-6\"></th>\n                 </tr>\n               </thead>\n               <tbody className=\"divide-y divide-gray-100 block md:table-row-group\">\n                 {cart.map(item => (\n                   <tr key={item.id} className=\"block md:table-row p-4 md:p-0\">\n                      <td className=\"py-4 md:py-6 px-2 md:px-6 flex items-center gap-4 border-b md:border-0 border-gray-100\">\n                        <div className=\"w-20 h-20 bg-gray-50 rounded-xl flex items-center justify-center shrink-0\">\n                           <img src={item.image} alt={item.title} className=\"w-16 h-16 object-contain mix-blend-multiply\" />\n                        </div>\n                        <div>\n                          <h4 className=\"font-bold text-gray-900 mb-1\">{item.title}</h4>\n                          <div className=\"text-xs text-gray-500 space-y-1\">\n                            <p>\330\250\330\261\331\206\330\257: {item.brand}</p>\n                            {item.warranty && <p>\332\257\330\247\330\261\330\247\331\206\330\252\333\214: {item.warranty}</p>}\n                          </div>\n                        </div>\n                      </td>\n                      <td className=\"py-2 md:py-6 px-2 md:px-6 text-center text-gray-800 font-medium block md:table-cell before:content-[\'\331\202\333\214\331\205\330\252_\331\210\330\247\330\255\330\257:\'] md:before:content-none before:ml-2 before:text-gray-500 flex md:block justify-between items-center\">\n                        {item.price.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206\n                      </td>\n                      <td className=\"py-2 md:py-6 px-2 md:px-6 block md:table-cell border-b md:border-0 border-gray-100 flex md:block justify-between items-center before:content-[\'\330\252\330\271\330\257\330\247\330\257:\'] md:before:content-none before:ml-2 before:text-gray-500\">\n                        <div className=\"flex items-center justify-center border border-gray-200 rounded-lg w-24 mx-auto\">\n                          <button onClick={() => updateQuantity(item.id, item.quantity + 1)} className=\"px-3 py-2 text-gray-500 hover:text-orange-600\">+</button>\n                          <span className=\"px-2 font-medium\">{item.quantity.toLocaleString(\'fa-IR\')}</span>\n                          <button onClick={() => updateQuantity(item.id, item.quantity - 1)} className=\"px-3 py-2 text-gray-500 hover:text-orange-600\">-</button>\n                        </div>\n                      </td>\n                      <td className=\"py-4 md:py-6 px-2 md:px-6 text-left font-bold text-orange-600 block md:table-cell flex md:block justify-between items-center before:content-[\'\331\205\330\254\331\205\331\210\330\271:\'] md:before:content-none before:ml-2 before:text-gray-500\">\n                        {(item.price * item.quantity).toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206\n                      </td>\n                      <td className=\"py-2 md:py-6 px-2 md:px-6 text-left block md:table-cell\">\n                         <button onClick={() => removeFromCart(item.id)} className=\"text-gray-400 hover:text-red-500 p-2 w-full md:w-auto text-center\"><Trash2 className=\"h-5 w-5 mx-auto\" /></button>\n                      </td>\n                   </tr>\n                 ))}\n               </tbody>\n             </table>\n           </div>\n           \n           <div className=\"mt-6 flex justify-start\">\n             <button onClick={clearCart} className=\"flex items-center gap-2 text-red-500 text-sm font-medium hover:text-red-600\">\n               <Trash2 className=\"h-4 w-4\" /> \331\276\330\247\332\251 \332\251\330\261\330\257\331\206 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257\n             </button>\n           </div>\n        </div>\n\n        {/* Order Summary */}\n        <div className=\"w-full lg:w-1/3\">\n           <div className=\"bg-gray-50 rounded-2xl p-6 border border-gray-200 sticky top-28\">\n             <h3 className=\"font-black text-gray-900 text-xl mb-6\">\330\256\331\204\330\247\330\265\331\207 \330\263\331\201\330\247\330\261\330\264</h3>\n             \n             <div className=\"space-y-4 mb-6 text-sm\">\n               <div className=\"flex justify-between text-gray-600\">\n                 <span>\330\254\331\205\330\271 \332\251\331\204 \332\251\330\247\331\204\330\247\331\207\330\247</span>\n                 <span className=\"font-medium text-gray-900\">{cartTotal.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206</span>\n               </div>\n               <div className=\"flex justify-between text-gray-600\">\n                 <span>\330\252\330\256\331\201\333\214\331\201</span>\n                 <span className=\"text-red-500 font-medium\">\333\260 \330\252\331\210\331\205\330\247\331\206</span>\n               </div>\n               <div className=\"flex justify-between items-center text-gray-600\">\n                 <span>\331\207\330\262\333\214\331\206\331\207 \330\247\330\261\330\263\330\247\331\204</span>\n                 {isFreeShipping ? (\n                   <span className=\"text-emerald-600 font-bold flex items-center gap-1 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200\">\n                     <CheckCircle2 className=\"h-3.5 w-3.5\" /> \330\261\330\247\333\214\332\257\330\247\331\206\n                   </span>\n                 ) : (\n                   <span className=\"text-gray-400 text-xs\">\330\257\330\261 \331\205\330\261\330\255\331\204\331\207 \330\250\330\271\330\257 \331\205\330\255\330\247\330\263\330\250\331\207 \331\205\333\214\342\200\214\330\264\331\210\330\257</span>\n                 )}\n               </div>\n             </div>\n             \n             <div className=\"border-t border-gray-200 pt-6 mb-6\">\n               <div className=\"flex justify-between items-center mb-2\">\n                 <span className=\"font-bold text-gray-900\">\331\205\330\250\331\204\330\272 \331\202\330\247\330\250\331\204 \331\276\330\261\330\257\330\247\330\256\330\252</span>\n                 <span className=\"text-2xl font-black text-orange-600\">{cartTotal.toLocaleString(\'fa-IR\')} <span className=\"text-sm font-normal text-gray-600\">\330\252\331\210\331\205\330\247\331\206</span></span>\n               </div>\n               {!isFreeShipping && (\n                 <p className=\"text-xs text-orange-600/90 mt-2 font-medium\">\n                   \360\237\222\241 \330\252\331\206\331\207\330\247 {amountLeft.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206 \330\257\333\214\332\257\330\261 \330\252\330\247 \330\247\330\261\330\263\330\247\331\204 \330\261\330\247\333\214\332\257\330\247\331\206\n                 </p>\n               )}\n             </div>\n             \n             <Link to=\"/checkout\" className=\"block w-full bg-orange-600 hover:bg-orange-700 text-white text-center font-bold py-4 rounded-xl transition-colors mb-4\">\n               \330\247\330\257\330\247\331\205\331\207 \331\201\330\261\330\247\333\214\331\206\330\257 \330\256\330\261\333\214\330\257\n             </Link>\n             \n             <div className=\"text-center text-xs text-gray-500 flex flex-col items-center gap-2\">\n               <span className=\"flex items-center gap-1\"><User className=\"h-4 w-4 inline\" /> \330\247\331\205\332\251\330\247\331\206 \330\256\330\261\333\214\330\257 \330\250\330\257\331\210\331\206 \330\271\330\266\331\210\333\214\330\252</span>\n             </div>\n           </div>\n        </div>\n      </div>\n    </motion.div>\n  );\n}"
