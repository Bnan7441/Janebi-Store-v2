      original_chunk {
        target_content: "      {/* Main Content */}\n      <div className=\"w-full lg:w-3/4\">\n        <h1 className=\"text-2xl font-black text-gray-900 mb-8\">\330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \331\205\331\206</h1>\n\n        <div className=\"space-y-6\">\n          {loading ? (\n            Array.from({ length: 2 }).map((_, idx) => (\n              <OrderCardSkeleton key={idx} />\n            ))\n          ) : (\n            mockOrders.map((order) => (\n             <div key={order.id} className=\"bg-white border border-gray-200 rounded-2xl overflow-hidden\">\n                <div className=\"bg-gray-50 p-4 sm:p-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                  <div className=\"flex items-center gap-6\">\n                    <div>\n                      <div className=\"text-xs text-gray-500 mb-1\">\330\264\331\205\330\247\330\261\331\207 \330\263\331\201\330\247\330\261\330\264</div>\n                      <div className=\"font-bold text-gray-900\">{order.id}</div>\n                    </div>\n                    <div>\n                      <div className=\"text-xs text-gray-500 mb-1\">\330\252\330\247\330\261\333\214\330\256 \330\253\330\250\330\252</div>\n                      <div className=\"font-bold text-gray-900 text-sm\">{order.date}</div>\n                    </div>\n                    <div>\n                      <div className=\"text-xs text-gray-500 mb-1\">\331\205\330\250\331\204\330\272 \332\251\331\204</div>\n                      <div className=\"font-bold text-gray-900 text-sm\">{order.total.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206</div>\n                    </div>\n                  </div>\n                  \n                  <div className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm font-medium ${\n                    order.status === \'delivered\' ? \'bg-green-50 text-green-700\' : \'bg-orange-50 text-orange-700\'\n                  }`}>\n                      {order.status === \'delivered\' ? <CheckCircle className=\"h-4 w-4\" /> : <Clock className=\"h-4 w-4\" />}\n                      {order.statusText}\n                  </div>\n                </div>\n                \n                <div className=\"p-4 sm:p-6 print:border-none print:shadow-none\">\n                  <div className=\"flex flex-col gap-4 mb-6\">\n                    {order.items.map((item, idx) => (\n                      <div key={idx} className=\"flex items-center gap-4 py-2 border-b border-gray-100 last:border-0 print:border-b print:border-black/10\">\n                        <div className=\"relative w-16 h-16 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-center p-2 shrink-0\">\n                          <img src={item.image} alt={item.title} className=\"max-w-full max-h-full mix-blend-multiply\" />\n                          <span className=\"absolute -top-2 -right-2 bg-gray-800 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full font-bold\">\n                            {item.qty}\n                          </span>\n                        </div>\n                        <div className=\"grow\">\n                          <h4 className=\"font-bold text-gray-900 text-sm md:text-base line-clamp-1\">{item.title}</h4>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n\n                  <div className=\"flex justify-end mt-4 sm:mt-0 print:hidden\">\n                    <button \n                      onClick={() => handlePrint(order.id)}\n                      className=\"text-gray-500 hover:text-orange-600 font-medium text-sm flex items-center gap-1 bg-white border border-gray-200 px-3 py-2 rounded-lg transition-colors\"\n                    >\n                      <Printer className=\"h-4 w-4\" /> \332\206\330\247\331\276 \331\201\330\247\332\251\330\252\331\210\330\261\n                    </button>\n                  </div>\n                </div>\n             </div>\n           )))\n         }\n        </div>\n      </div>"
        replacement_content: "      {/* Main Content */}\n      <div className=\"w-full lg:w-3/4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6\">\n          <h1 className=\"text-2xl font-black text-gray-900 dark:text-gray-100\">\330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \331\205\331\206 ({filteredOrders.length.toLocaleString(\'fa-IR\')})</h1>\n          \n          <input \n            type=\"text\" \n            placeholder=\"\330\254\330\263\330\252\330\254\331\210\333\214 \332\251\330\257 \330\263\331\201\330\247\330\261\330\264 \333\214\330\247 \331\206\330\247\331\205 \332\251\330\247\331\204\330\247...\" \n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"px-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 text-xs sm:text-sm rounded-xl focus:outline-none focus:border-orange-500 w-full sm:w-64\"\n          />\n        </div>\n\n        <div className=\"space-y-6\">\n          {loading ? (\n            Array.from({ length: 2 }).map((_, idx) => (\n              <OrderCardSkeleton key={idx} />\n            ))\n          ) : filteredOrders.length === 0 ? (\n            <div className=\"text-center py-12 bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800\">\n              <Package className=\"h-12 w-12 mx-auto text-gray-300 dark:text-gray-600 mb-3\" />\n              <p className=\"text-gray-500 dark:text-gray-400 font-medium\">\331\207\333\214\332\206 \330\263\331\201\330\247\330\261\330\264\333\214 \333\214\330\247\331\201\330\252 \331\206\330\264\330\257</p>\n            </div>\n          ) : (\n            filteredOrders.map((order) => (\n             <div key={order.id} className=\"bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden shadow-sm\">\n                <div className=\"bg-gray-50 dark:bg-gray-800/60 p-4 sm:p-6 border-b border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                  <div className=\"flex flex-wrap items-center gap-4 sm:gap-6\">\n                    <div>\n                      <div className=\"text-xs text-gray-500 dark:text-gray-400 mb-0.5\">\330\264\331\205\330\247\330\261\331\207 \331\276\333\214\332\257\333\214\330\261\333\214</div>\n                      <div className=\"font-extrabold text-gray-900 dark:text-gray-100 text-sm\">{order.id}</div>\n                    </div>\n                    <div>\n                      <div className=\"text-xs text-gray-500 dark:text-gray-400 mb-0.5\">\330\252\330\247\330\261\333\214\330\256 \330\253\330\250\330\252</div>\n                      <div className=\"font-bold text-gray-800 dark:text-gray-200 text-xs sm:text-sm\">{order.date}</div>\n                    </div>\n                    <div>\n                      <div className=\"text-xs text-gray-500 dark:text-gray-400 mb-0.5\">\331\205\330\250\331\204\330\272 \331\276\330\261\330\257\330\247\330\256\330\252 \330\264\330\257\331\207</div>\n                      <div className=\"font-bold text-orange-600 dark:text-orange-400 text-xs sm:text-sm\">{order.total.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206</div>\n                    </div>\n                  </div>\n                  \n                  <div className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold ${\n                    order.status === \'delivered\' ? \'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-400\' :\n                    order.status === \'cancelled\' ? \'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-400\' :\n                    \'bg-orange-50 text-orange-700 dark:bg-orange-950/40 dark:text-orange-400\'\n                  }`}>\n                     {order.status === \'delivered\' ? <CheckCircle className=\"h-4 w-4\" /> : <Clock className=\"h-4 w-4\" />}\n                     {order.statusText}\n                  </div>\n                </div>\n                \n                <div className=\"p-4 sm:p-6 print:border-none print:shadow-none\">\n                  <div className=\"flex flex-col gap-4 mb-6\">\n                    {order.items.map((item: any, idx: number) => (\n                      <div key={idx} className=\"flex items-center gap-4 py-2 border-b border-gray-100 dark:border-gray-800 last:border-0\">\n                        <div className=\"relative w-16 h-16 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 flex items-center justify-center p-2 shrink-0\">\n                          <img src={item.image} alt={item.title} className=\"max-w-full max-h-full object-contain mix-blend-multiply dark:mix-blend-normal\" />\n                          <span className=\"absolute -top-2 -right-2 bg-gray-800 dark:bg-gray-700 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full font-bold\">\n                            {item.qty}\n                          </span>\n                        </div>\n                        <div className=\"grow\">\n                          <h4 className=\"font-bold text-gray-900 dark:text-gray-100 text-sm line-clamp-1\">{item.title}</h4>\n                          <div className=\"text-xs text-gray-500 dark:text-gray-400 mt-1\">\n                            {item.price ? `${item.price.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206` : \'\'}\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n\n                  <div className=\"flex flex-wrap items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-800 gap-3 print:hidden\">\n                    <div className=\"text-xs text-gray-500 dark:text-gray-400\">\n                      {order.recipient?.address ? `\