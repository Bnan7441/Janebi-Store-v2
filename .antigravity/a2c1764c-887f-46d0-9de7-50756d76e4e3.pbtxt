  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { ShoppingCart, Heart, User, Menu, Headphones, Smartphone, BatteryCharging, Cable, ShieldCheck, Zap, Moon, Sun, X, ArrowLeftRight } from \'lucide-react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useWishlist } from \'../contexts/WishlistContext\';\nimport { useTheme } from \'../contexts/ThemeContext\';\nimport { useCart } from \'../contexts/CartContext\';\nimport { useCompare } from \'../contexts/CompareContext\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport HeaderSearch from \'./HeaderSearch\';\n\nexport default function Header() {\n  const { wishlist } = useWishlist();\n  const { cartCount } = useCart();\n  const { compareItems } = useCompare();\n  const { isDarkMode, toggleTheme } = useTheme();\n  const navigate = useNavigate();\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  return (\n    <header className=\"bg-white/85 backdrop-blur-xl border-b border-gray-200/60 sticky top-0 z-50 shadow-sm transition-colors duration-300\">\n      {/* Top Banner */}\n      <div className=\"bg-gray-800 text-white text-xs text-center py-2 flex items-center justify-center gap-2\">\n        <span>\330\247\330\261\330\263\330\247\331\204 \330\261\330\247\333\214\332\257\330\247\331\206 \330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \330\250\330\247\331\204\330\247\333\214 \333\267\333\265\333\260 \331\207\330\262\330\247\330\261 \330\252\331\210\331\205\330\247\331\206</span>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><rect width=\"16\" height=\"16\" x=\"4\" y=\"4\" rx=\"2\"/><rect width=\"6\" height=\"6\" x=\"9\" y=\"9\" rx=\"1\"/><path d=\"M15 4v16\"/><path d=\"M9 4v16\"/></svg>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-20\">\n          {/* Logo */}\n          <div className=\"shrink-0 flex items-center gap-2\">\n            <button className=\"lg:hidden p-2 text-gray-600 hover:text-orange-600 focus:outline-none\" onClick={() => setMobileMenuOpen(!mobileMenuOpen)}>\n              {mobileMenuOpen ? <X className=\"h-6 w-6\" /> : <Menu className=\"h-6 w-6\" />}\n            </button>\n            <Link to=\"/\" className=\"text-3xl font-black text-gray-900 flex items-center gap-2\">\n               <span className=\"text-orange-600\">\333\270</span> \330\254\330\247\331\206\330\250\333\214 \330\242\330\261\331\206\330\247\n            </Link>\n          </div>\n\n          {/* Real-time Search Bar */}\n          <div className=\"flex-1 max-w-2xl mx-8 relative hidden md:block\">\n            <HeaderSearch />\n          </div>\n\n          {/* Actions */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2.5 md:gap-3\">\n            {/* Theme Toggle */}\n            <button\n              onClick={toggleTheme}\n              title={isDarkMode ? \'\330\255\330\247\331\204\330\252 \330\261\331\210\330\262\' : \'\330\255\330\247\331\204\330\252 \330\264\330\250\'}\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60 hidden sm:flex\"\n            >\n              <div className=\"relative p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-orange-100/80 dark:group-hover:bg-orange-950/40 transition-colors duration-200\">\n                {isDarkMode ? (\n                  <Sun className=\"h-4 sm:h-5 w-4 sm:w-5 text-amber-500 group-hover:rotate-45 transition-transform duration-300\" />\n                ) : (\n                  <Moon className=\"h-4 sm:h-5 w-4 sm:w-5 text-indigo-600 group-hover:-rotate-12 transition-transform duration-300\" />\n                )}\n              </div>\n              <span className=\"text-[11px] font-medium mt-1 group-hover:font-semibold transition-all\">\n                {isDarkMode ? \'\330\261\331\210\330\262\' : \'\330\264\330\250\'}\n              </span>\n            </button>\n\n            {/* Profile */}\n            <Link\n              to=\"/profile\"\n              title=\"\330\255\330\263\330\247\330\250 \332\251\330\247\330\261\330\250\330\261\333\214\"\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60 hidden sm:flex\"\n            >\n              <div className=\"p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-orange-100/80 dark:group-hover:bg-orange-950/40 transition-colors duration-200 group-hover:-translate-y-0.5 transition-transform\">\n                <User className=\"h-4 sm:h-5 w-4 sm:w-5 text-gray-600 dark:text-gray-300 group-hover:text-orange-600 dark:group-hover:text-orange-400\" />\n              </div>\n              <span className=\"text-[11px] font-medium mt-1\">\330\255\330\263\330\247\330\250 \332\251\330\247\330\261\330\250\330\261\333\214</span>\n            </Link>\n\n            {/* Compare */}\n            <Link\n              to=\"/compare\"\n              title=\"\331\205\331\202\330\247\333\214\330\263\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\"\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60 hidden sm:flex\"\n            >\n              <div className=\"relative p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-orange-100/80 dark:group-hover:bg-orange-950/40 transition-colors duration-200 group-hover:-translate-y-0.5 transition-transform\">\n                <ArrowLeftRight className=\"h-4 sm:h-5 w-4 sm:w-5 text-gray-600 dark:text-gray-300 group-hover:text-orange-600 dark:group-hover:text-orange-400\" />\n                {compareItems.length > 0 && (\n                  <motion.span\n                    initial={{ scale: 0 }}\n                    animate={{ scale: 1 }}\n                    className=\"absolute -top-1.5 -right-1.5 bg-blue-600 text-white text-[10px] font-bold h-4 min-w-4 px-1 rounded-full flex items-center justify-center shadow-sm\"\n                  >\n                    {compareItems.length}\n                  </motion.span>\n                )}\n              </div>\n              <span className=\"text-[11px] font-medium mt-1\">\331\205\331\202\330\247\333\214\330\263\331\207</span>\n            </Link>\n\n            {/* Wishlist */}\n            <Link\n              to=\"/wishlist\"\n              title=\"\331\204\333\214\330\263\330\252 \330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247\"\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60\"\n            >\n              <div className=\"relative p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-rose-100/80 dark:group-hover:bg-rose-950/40 transition-colors duration-200 group-hover:-translate-y-0.5 transition-transform\">\n                <Heart className={`h-4 sm:h-5 w-4 sm:w-5 ${wishlist.length > 0 ? \'text-rose-500 fill-rose-500\' : \'text-gray-600 dark:text-gray-300 group-hover:text-rose-500\'}`} />\n                {wishlist.length > 0 && (\n                  <motion.span\n                    initial={{ scale: 0 }}\n                    animate={{ scale: 1 }}\n                    className=\"absolute -top-1.5 -right-1.5 bg-rose-500 text-white text-[10px] font-bold h-4 min-w-4 px-1 rounded-full flex items-center justify-center shadow-sm\"\n                  >\n                    {wishlist.length}\n                  </motion.span>\n                )}\n              </div>\n              <span className=\"text-[11px] font-medium mt-1 hidden sm:block\">\330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247</span>\n            </Link>\n\n            {/* Cart Button */}\n            <Link\n              to=\"/cart\"\n              title=\"\330\263\330\250\330\257 \330\256\330\261\333\214\330\257\"\n              className=\"group relative flex items-center gap-2 px-3 py-2 sm:px-3.5 sm:py-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white shadow-md shadow-orange-500/20 hover:shadow-lg hover:shadow-orange-500/30 transition-all duration-200 hover:scale-105\"\n            >\n              <div className=\"relative flex items-center justify-center\">\n                <ShoppingCart className=\"h-5 w-5 transition-transform duration-200 group-hover:-translate-y-0.5\" />\n                {cartCount > 0 && (\n                  <motion.span\n                    initial={{ scale: 0 }}\n                    animate={{ scale: 1 }}\n                    className=\"absolute -top-2.5 -right-2.5 bg-white text-orange-600 text-[10px] font-extrabold h-4 min-w-4 px-1 rounded-full flex items-center justify-center shadow-md border border-orange-200\"\n                  >\n                    {cartCount}\n                  </motion.span>\n                )}\n              </div>\n              <div className=\"hidden sm:flex flex-col items-start leading-none\">\n                <span className=\"text-[12px] font-bold\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257</span>\n                {cartCount > 0 ? (\n                  <span className=\"text-[10px] opacity-90 mt-0.5 font-medium\">{cartCount} \332\251\330\247\331\204\330\247</span>\n                ) : (\n                  <span className=\"text-[10px] opacity-80 mt-0.5 font-normal\">\330\256\330\247\331\204\333\214</span>\n                )}\n              </div>\n            </Link>\n          </div>\n        </div>\n\n        {/* Navigation */}\n        <nav className=\"flex items-center justify-center gap-8 py-3 text-sm text-gray-700 font-medium hidden lg:flex border-t border-gray-100\">\n           <Link to=\"/\" className=\"hover:text-orange-600 transition-colors text-orange-600\">\330\256\330\247\331\206\331\207</Link>\n           <Link to=\"/products?category=\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261\" className=\"hover:text-orange-600 transition-colors flex items-center gap-1\">\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261 <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/></svg></Link>\n           <Link to=\"/products?category=\332\257\331\204\330\263\" className=\"hover:text-orange-600 transition-colors flex items-center gap-1\">\332\257\331\204\330\263 <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/></svg></Link>\n           <Link to=\"/products?category=\330\264\330\247\330\261\332\230\330\261\" className=\"hover:text-orange-600 transition-colors\">\330\264\330\247\330\261\332\230\330\261</Link>\n           <Link to=\"/products?category=\332\251\330\247\330\250\331\204\" className=\"hover:text-orange-600 transition-colors\">\332\251\330\247\330\250\331\204</Link>\n           <Link to=\"/products?category=\331\207\331\206\330\257\330\262\331\201\330\261\333\214\" className=\"hover:text-orange-600 transition-colors flex items-center gap-1\">\331\207\331\206\330\257\330\262\331\201\330\261\333\214 <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/></svg></Link>\n           <Link to=\"/products?category=\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251\" className=\"hover:text-orange-600 transition-colors flex items-center gap-1\">\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251 <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/></svg></Link>\n           <Link to=\"/products?category=\331\276\330\247\333\214\331\207 \331\210 \331\206\332\257\331\207\330\257\330\247\330\261\331\206\330\257\331\207\" className=\"hover:text-orange-600 transition-colors flex items-center gap-1\">\331\276\330\247\333\214\331\207 \331\210 \331\206\332\257\331\207\330\257\330\247\330\261\331\206\330\257\331\207 <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/></svg></Link>\n           <Link to=\"/brands\" className=\"hover:text-orange-600 transition-colors flex items-center gap-1\">\330\250\330\261\331\206\330\257\331\207\330\247 <svg width=\"10\" height=\"6\" viewBox=\"0 0 10 6\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 1L5 5L9 1\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/></svg></Link>\n           <Link to=\"/blog\" className=\"hover:text-orange-600 transition-colors\">\331\210\330\250\331\204\330\247\332\257</Link>\n           <Link to=\"/contact\" className=\"hover:text-orange-600 transition-colors\">\330\252\331\205\330\247\330\263 \330\250\330\247 \331\205\330\247</Link>\n        </nav>\n      </div>\n\n      {/* Mobile Menu */}\n      <AnimatePresence>\n      {mobileMenuOpen && (\n        <motion.div \n          initial={{ opacity: 0, height: 0, y: -20 }}\n          animate={{ opacity: 1, height: \'auto\', y: 0 }}\n          exit={{ opacity: 0, height: 0, y: -20 }}\n          transition={{ duration: 0.3, ease: \'easeInOut\' }}\n          className=\"lg:hidden bg-white/95 backdrop-blur-xl border-t border-gray-100 p-4 shadow-xl absolute w-full left-0 right-0 z-50 overflow-hidden\"\n        >\n          <div className=\"mb-4 md:hidden\">\n            <HeaderSearch onSearchSubmit={() => setMobileMenuOpen(false)} />\n          </div>\n          <div className=\"flex justify-around mb-4 sm:hidden pb-4 border-b border-gray-100\">\n            <button onClick={toggleTheme} className=\"flex flex-col items-center text-gray-600 hover:text-orange-600\">\n              {isDarkMode ? <Sun className=\"h-6 w-6\" /> : <Moon className=\"h-6 w-6\" />}\n              <span className=\"text-xs mt-1\">{isDarkMode ? \'\330\261\331\210\330\262\' : \'\330\264\330\250\'}</span>\n            </button>\n            <Link to=\"/profile\" onClick={() => setMobileMenuOpen(false)} className=\"flex flex-col items-center text-gray-600 hover:text-orange-600\">\n              <User className=\"h-6 w-6\" />\n              <span className=\"text-xs mt-1\">\330\255\330\263\330\247\330\250</span>\n            </Link>\n            <Link to=\"/compare\" onClick={() => setMobileMenuOpen(false)} className=\"flex flex-col items-center text-gray-600 hover:text-orange-600\">\n              <div className=\"relative text-xl\">\342\232\226\357\270\217</div>\n              <span className=\"text-xs mt-1\">\331\205\331\202\330\247\333\214\330\263\331\207</span>\n            </Link>\n          </div>\n          <nav className=\"flex flex-col space-y-3\">\n             <Link to=\"/\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\330\256\330\247\331\206\331\207</Link>\n             <Link to=\"/products?category=\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261</Link>\n             <Link to=\"/products?category=\332\257\331\204\330\263\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\332\257\331\204\330\263</Link>\n             <Link to=\"/products?category=\330\264\330\247\330\261\332\230\330\261\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\330\264\330\247\330\261\332\230\330\261</Link>\n             <Link to=\"/products?category=\332\251\330\247\330\250\331\204\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\332\251\330\247\330\250\331\204</Link>\n             <Link to=\"/products?category=\331\207\331\206\330\257\330\262\331\201\330\261\333\214\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\331\207\331\206\330\257\330\262\331\201\330\261\333\214</Link>\n             <Link to=\"/products?category=\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251</Link>\n             <Link to=\"/brands\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\330\250\330\261\331\206\330\257\331\207\330\247</Link>\n             <Link to=\"/blog\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\331\210\330\250\331\204\330\247\332\257</Link>\n             <Link to=\"/contact\" onClick={() => setMobileMenuOpen(false)} className=\"text-gray-800 hover:text-orange-600 font-medium\">\330\252\331\205\330\247\330\263 \330\250\330\247 \331\205\330\247</Link>\n          </nav>\n        </motion.div>\n      )}\n      </AnimatePresence>\n    </header>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport { ShoppingCart, Heart, User, Menu, Moon, Sun, X, ArrowLeftRight, Smartphone, Sparkles, ChevronDown } from \'lucide-react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useWishlist } from \'../contexts/WishlistContext\';\nimport { useTheme } from \'../contexts/ThemeContext\';\nimport { useCart } from \'../contexts/CartContext\';\nimport { useCompare } from \'../contexts/CompareContext\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport HeaderSearch from \'./HeaderSearch\';\n\nexport default function Header() {\n  const { wishlist } = useWishlist();\n  const { cartCount } = useCart();\n  const { compareItems } = useCompare();\n  const { isDarkMode, toggleTheme } = useTheme();\n  const navigate = useNavigate();\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  return (\n    <header className=\"bg-white/90 dark:bg-gray-900/90 backdrop-blur-xl border-b border-gray-200/80 dark:border-gray-800 sticky top-0 z-50 shadow-xs transition-colors duration-300\">\n      {/* Top Banner */}\n      <div className=\"bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 dark:from-black dark:via-gray-900 dark:to-black text-white text-xs text-center py-2 px-4 flex items-center justify-center gap-2 border-b border-gray-800\">\n        <Sparkles className=\"h-3.5 w-3.5 text-amber-400 animate-pulse shrink-0\" />\n        <span className=\"font-medium\">\330\247\330\261\330\263\330\247\331\204 \330\261\330\247\333\214\332\257\330\247\331\206 \330\250\330\261\330\247\333\214 \330\252\331\205\330\247\331\205\333\214 \330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \330\250\330\247\331\204\330\247\333\214 \333\262,\333\260\333\260\333\260,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206</span>\n        <span className=\"hidden sm:inline text-gray-400\">|</span>\n        <span className=\"hidden sm:inline text-amber-300 font-bold\">\332\251\330\257 \330\252\330\256\331\201\333\214\331\201: WELCOME10</span>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-20\">\n          {/* Logo */}\n          <div className=\"shrink-0 flex items-center gap-3\">\n            <button \n              className=\"lg:hidden p-2 text-gray-600 dark:text-gray-300 hover:text-orange-600 dark:hover:text-orange-400 focus:outline-none rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors\" \n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            >\n              {mobileMenuOpen ? <X className=\"h-6 w-6\" /> : <Menu className=\"h-6 w-6\" />}\n            </button>\n            <Link to=\"/\" className=\"flex items-center gap-2.5 group\">\n               <div className=\"w-10 h-10 rounded-2xl bg-gradient-to-tr from-orange-600 via-amber-500 to-orange-500 text-white font-black text-xl flex items-center justify-center shadow-md shadow-orange-500/20 group-hover:scale-105 transition-transform duration-300\">\n                 <Smartphone className=\"h-5 w-5\" />\n               </div>\n               <div className=\"flex flex-col\">\n                 <span className=\"text-xl sm:text-2xl font-black text-gray-900 dark:text-gray-100 tracking-tight flex items-center gap-1\">\n                   \330\254\330\247\331\206\330\250\333\214 <span className=\"text-orange-600 dark:text-orange-400\">\330\242\330\261\331\206\330\247</span>\n                 </span>\n                 <span className=\"text-[10px] text-gray-400 dark:text-gray-500 -mt-1 font-semibold tracking-wider\">JANEBI ARENA</span>\n               </div>\n            </Link>\n          </div>\n\n          {/* Search Bar */}\n          <div className=\"flex-1 max-w-2xl mx-8 relative hidden md:block\">\n            <HeaderSearch />\n          </div>\n\n          {/* Actions */}\n          <div className=\"flex items-center gap-1.5 sm:gap-2.5 md:gap-3\">\n            {/* Theme Toggle */}\n            <button\n              onClick={toggleTheme}\n              title={isDarkMode ? \'\330\255\330\247\331\204\330\252 \330\261\331\210\330\262\' : \'\330\255\330\247\331\204\330\252 \330\264\330\250\'}\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60 hidden sm:flex\"\n            >\n              <div className=\"relative p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-orange-100/80 dark:group-hover:bg-orange-950/40 transition-colors duration-200\">\n                {isDarkMode ? (\n                  <Sun className=\"h-4 sm:h-5 w-4 sm:w-5 text-amber-500 group-hover:rotate-45 transition-transform duration-300\" />\n                ) : (\n                  <Moon className=\"h-4 sm:h-5 w-4 sm:w-5 text-indigo-600 group-hover:-rotate-12 transition-transform duration-300\" />\n                )}\n              </div>\n              <span className=\"text-[11px] font-medium mt-1 group-hover:font-semibold transition-all\">\n                {isDarkMode ? \'\330\261\331\210\330\262\' : \'\330\264\330\250\'}\n              </span>\n            </button>\n\n            {/* Profile */}\n            <Link\n              to=\"/profile\"\n              title=\"\330\255\330\263\330\247\330\250 \332\251\330\247\330\261\330\250\330\261\333\214\"\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60 hidden sm:flex\"\n            >\n              <div className=\"p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-orange-100/80 dark:group-hover:bg-orange-950/40 transition-colors duration-200 group-hover:-translate-y-0.5 transition-transform\">\n                <User className=\"h-4 sm:h-5 w-4 sm:w-5 text-gray-600 dark:text-gray-300 group-hover:text-orange-600 dark:group-hover:text-orange-400\" />\n              </div>\n              <span className=\"text-[11px] font-medium mt-1\">\330\255\330\263\330\247\330\250</span>\n            </Link>\n\n            {/* Compare */}\n            <Link\n              to=\"/compare\"\n              title=\"\331\205\331\202\330\247\333\214\330\263\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\"\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60 hidden sm:flex\"\n            >\n              <div className=\"relative p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-orange-100/80 dark:group-hover:bg-orange-950/40 transition-colors duration-200 group-hover:-translate-y-0.5 transition-transform\">\n                <ArrowLeftRight className=\"h-4 sm:h-5 w-4 sm:w-5 text-gray-600 dark:text-gray-300 group-hover:text-orange-600 dark:group-hover:text-orange-400\" />\n                {compareItems.length > 0 && (\n                  <motion.span\n                    initial={{ scale: 0 }}\n                    animate={{ scale: 1 }}\n                    className=\"absolute -top-1.5 -right-1.5 bg-blue-600 text-white text-[10px] font-bold h-4 min-w-4 px-1 rounded-full flex items-center justify-center shadow-sm\"\n                  >\n                    {compareItems.length}\n                  </motion.span>\n                )}\n              </div>\n              <span className=\"text-[11px] font-medium mt-1\">\331\205\331\202\330\247\333\214\330\263\331\207</span>\n            </Link>\n\n            {/* Wishlist */}\n            <Link\n              to=\"/wishlist\"\n              title=\"\331\204\333\214\330\263\330\252 \330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247\"\n              className=\"group relative flex flex-col items-center justify-center p-1.5 sm:px-3 sm:py-1.5 rounded-xl text-gray-700 dark:text-gray-200 hover:text-orange-600 dark:hover:text-orange-400 hover:bg-orange-50/80 dark:hover:bg-gray-800/80 transition-all duration-200 border border-transparent hover:border-orange-100 dark:hover:border-gray-700/60\"\n            >\n              <div className=\"relative p-1.5 rounded-lg bg-gray-100/80 dark:bg-gray-800 group-hover:bg-rose-100/80 dark:group-hover:bg-rose-950/40 transition-colors duration-200 group-hover:-translate-y-0.5 transition-transform\">\n                <Heart className={`h-4 sm:h-5 w-4 sm:w-5 ${wishlist.length > 0 ? \'text-rose-500 fill-rose-500\' : \'text-gray-600 dark:text-gray-300 group-hover:text-rose-500\'}`} />\n                {wishlist.length > 0 && (\n                  <motion.span\n                    initial={{ scale: 0 }}\n                    animate={{ scale: 1 }}\n                    className=\"absolute -top-1.5 -right-1.5 bg-rose-500 text-white text-[10px] font-bold h-4 min-w-4 px-1 rounded-full flex items-center justify-center shadow-sm\"\n                  >\n                    {wishlist.length}\n                  </motion.span>\n                )}\n              </div>\n              <span className=\"text-[11px] font-medium mt-1 hidden sm:block\">\330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247</span>\n            </Link>\n\n            {/* Cart Button */}\n            <Link\n              to=\"/cart\"\n              title=\"\330\263\330\250\330\257 \330\256\330\261\333\214\330\257\"\n              className=\"group relative flex items-center gap-2 px-3.5 py-2 rounded-xl bg-gradient-to-r from-orange-600 to-amber-500 hover:from-orange-700 hover:to-amber-600 text-white shadow-md shadow-orange-500/20 hover:shadow-lg hover:shadow-orange-500/30 transition-all duration-200 active:scale-95\"\n            >\n              <div className=\"relative flex items-center justify-center\">\n                <ShoppingCart className=\"h-5 w-5 transition-transform duration-200 group-hover:-translate-y-0.5\" />\n                {cartCount > 0 && (\n                  <motion.span\n                    initial={{ scale: 0 }}\n                    animate={{ scale: 1 }}\n                    className=\"absolute -top-2.5 -right-2.5 bg-white text-orange-600 text-[10px] font-extrabold h-4 min-w-4 px-1 rounded-full flex items-center justify-center shadow-md border border-orange-200\"\n                  >\n                    {cartCount}\n                  </motion.span>\n                )}\n              </div>\n              <div className=\"hidden sm:flex flex-col items-start leading-none\">\n                <span className=\"text-[12px] font-bold\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257</span>\n                {cartCount > 0 ? (\n                  <span className=\"text-[10px] opacity-90 mt-0.5 font-medium\">{cartCount} \332\251\330\247\331\204\330\247</span>\n                ) : (\n                  <span className=\"text-[10px] opacity-80 mt-0.5 font-normal\">\330\256\330\247\331\204\333\214</span>\n                )}\n              </div>\n            </Link>\n          </div>\n        </div>\n\n        {/* Categories Navbar */}\n        <nav className=\"flex items-center justify-center gap-6 xl:gap-8 py-3 text-sm font-semibold hidden lg:flex border-t border-gray-100 dark:border-gray-800/80 text-gray-700 dark:text-gray-300\">\n           <Link to=\"/\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors text-orange-600 dark:text-orange-400\">\330\256\330\247\331\206\331\207</Link>\n           <Link to=\"/products?category=\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors flex items-center gap-1\">\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261</Link>\n           <Link to=\"/products?category=\332\257\331\204\330\263\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors flex items-center gap-1\">\332\257\331\204\330\263</Link>\n           <Link to=\"/products?category=\330\264\330\247\330\261\332\230\330\261\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors\">\330\264\330\247\330\261\332\230\330\261</Link>\n           <Link to=\"/products?category=\332\251\330\247\330\250\331\204\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors\">\332\251\330\247\330\250\331\204</Link>\n           <Link to=\"/products?category=\331\207\331\206\330\257\330\262\331\201\330\261\333\214\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors flex items-center gap-1\">\331\207\331\206\330\257\330\262\331\201\330\261\333\214</Link>\n           <Link to=\"/products?category=\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors flex items-center gap-1\">\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251</Link>\n           <Link to=\"/brands\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors\">\330\250\330\261\331\206\330\257\331\207\330\247</Link>\n           <Link to=\"/offers\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors text-rose-600 dark:text-rose-400 flex items-center gap-1\">\n             <Sparkles className=\"h-3.5 w-3.5\" /> \331\276\333\214\330\264\331\206\331\207\330\247\330\257\331\207\330\247\333\214 \330\264\332\257\331\201\330\252\342\200\214\330\247\331\206\332\257\333\214\330\262\n           </Link>\n           <Link to=\"/blog\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors\">\331\210\330\250\331\204\330\247\332\257</Link>\n           <Link to=\"/contact\" className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors\">\330\252\331\205\330\247\330\263 \330\250\330\247 \331\205\330\247</Link>\n        </nav>\n      </div>\n\n      {/* Mobile Drawer */}\n      <AnimatePresence>\n      {mobileMenuOpen && (\n        <motion.div \n          initial={{ opacity: 0, height: 0 }}\n          animate={{ opacity: 1, height: \'auto\' }}\n          exit={{ opacity: 0, height: 0 }}\n          transition={{ duration: 0.25, ease: \'easeInOut\' }}\n          className=\"lg:hidden bg-white/98 dark:bg-gray-900/98 backdrop-blur-2xl border-t border-gray-100 dark:border-gray-800 p-4 shadow-2xl absolute w-full left-0 right-0 z-50 overflow-hidden text-gray-800 dark:text-gray-100\"\n        >\n          <div className=\"mb-4 md:hidden\">\n            <HeaderSearch onSearchSubmit={() => setMobileMenuOpen(false)} />\n          </div>\n          <div className=\"flex justify-around mb-4 sm:hidden pb-4 border-b border-gray-100 dark:border-gray-800\">\n            <button onClick={toggleTheme} className=\"flex flex-col items-center text-gray-600 dark:text-gray-300 hover:text-orange-600\">\n              {isDarkMode ? <Sun className=\"h-6 w-6 text-amber-400\" /> : <Moon className=\"h-6 w-6\" />}\n              <span className=\"text-xs mt-1\">{isDarkMode ? \'\330\261\331\210\330\262\' : \'\330\264\330\250\'}</span>\n            </button>\n            <Link to=\"/profile\" onClick={() => setMobileMenuOpen(false)} className=\"flex flex-col items-center text-gray-600 dark:text-gray-300 hover:text-orange-600\">\n              <User className=\"h-6 w-6\" />\n              <span className=\"text-xs mt-1\">\330\255\330\263\330\247\330\250</span>\n            </Link>\n            <Link to=\"/compare\" onClick={() => setMobileMenuOpen(false)} className=\"flex flex-col items-center text-gray-600 dark:text-gray-300 hover:text-orange-600\">\n              <ArrowLeftRight className=\"h-6 w-6\" />\n              <span className=\"text-xs mt-1\">\331\205\331\202\330\247\333\214\330\263\331\207</span>\n            </Link>\n          </div>\n          <nav className=\"flex flex-col space-y-3\">\n             <Link to=\"/\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\330\256\330\247\331\206\331\207</Link>\n             <Link to=\"/products?category=\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\331\202\330\247\330\250 \331\210 \332\251\330\247\331\210\330\261</Link>\n             <Link to=\"/products?category=\332\257\331\204\330\263\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\332\257\331\204\330\263</Link>\n             <Link to=\"/products?category=\330\264\330\247\330\261\332\230\330\261\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\330\264\330\247\330\261\332\230\330\261</Link>\n             <Link to=\"/products?category=\332\251\330\247\330\250\331\204\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\332\251\330\247\330\250\331\204</Link>\n             <Link to=\"/products?category=\331\207\331\206\330\257\330\262\331\201\330\261\333\214\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\331\207\331\206\330\257\330\262\331\201\330\261\333\214</Link>\n             <Link to=\"/products?category=\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\331\276\330\247\331\210\330\261\330\250\330\247\331\206\332\251</Link>\n             <Link to=\"/offers\" onClick={() => setMobileMenuOpen(false)} className=\"text-rose-600 dark:text-rose-400 font-bold\">\330\252\330\256\331\201\333\214\331\201\342\200\214\331\207\330\247\333\214 \331\210\333\214\332\230\331\207</Link>\n             <Link to=\"/brands\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\330\250\330\261\331\206\330\257\331\207\330\247</Link>\n             <Link to=\"/blog\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\331\210\330\250\331\204\330\247\332\257</Link>\n             <Link to=\"/contact\" onClick={() => setMobileMenuOpen(false)} className=\"hover:text-orange-600 dark:hover:text-orange-400 font-medium\">\330\252\331\205\330\247\330\263 \330\250\330\247 \331\205\330\247</Link>\n          </nav>\n        </motion.div>\n      )}\n      </AnimatePresence>\n    </header>\n  );\n}\n"
