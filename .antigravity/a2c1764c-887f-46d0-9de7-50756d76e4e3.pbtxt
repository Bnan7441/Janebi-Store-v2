      replacement_content: "export default function OrderHistory() {\n  const { addToast } = useToast();\n  const [loading, setLoading] = useState(true);\n  const [orders, setOrders] = useState<any[]>([]);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  useEffect(() => {\n    try {\n      const savedOrders = localStorage.getItem(\'user_orders\');\n      if (savedOrders) {\n        setOrders(JSON.parse(savedOrders));\n      } else {\n        setOrders(mockOrders);\n      }\n    } catch (e) {\n      setOrders(mockOrders);\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  const handlePrint = (orderId: string) => {\n    addToast(`\331\201\330\247\332\251\330\252\331\210\330\261 \330\263\331\201\330\247\330\261\330\264 ${orderId} \330\257\330\261 \330\255\330\247\331\204 \330\242\331\205\330\247\330\257\331\207\342\200\214\330\263\330\247\330\262\333\214 \330\250\330\261\330\247\333\214 \332\206\330\247\331\276 \330\247\330\263\330\252...`, \'info\');\n    setTimeout(() => {\n      window.print();\n    }, 300);\n  };\n\n  const handleCancelOrder = (orderId: string) => {\n    const updated = orders.map(o => o.id === orderId ? { ...o, status: \'cancelled\', statusText: \'\331\204\330\272\331\210 \330\264\330\257\331\207\' } : o);\n    setOrders(updated);\n    try {\n      localStorage.setItem(\'user_orders\', JSON.stringify(updated));\n    } catch(e) {}\n    addToast(`\330\263\331\201\330\247\330\261\330\264 ${orderId} \330\250\330\247 \331\205\331\210\331\201\331\202\333\214\330\252 \331\204\330\272\331\210 \330\264\330\257`, \'info\');\n  };\n\n  const filteredOrders = orders.filter(o => \n    o.id.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    o.items.some((i: any) => i.title.includes(searchQuery))\n  );"
