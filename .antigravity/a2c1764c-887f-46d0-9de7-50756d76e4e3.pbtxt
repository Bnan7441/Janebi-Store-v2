    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useToast } from \'../contexts/ToastContext\';\nimport { motion } from \'motion/react\';\n\nexport default function Checkout() {\n  const [formData, setFormData] = useState({\n    name: \'\',\n    phone: \'\',\n    province: \'\',\n    city: \'\',\n    address: \'\'\n  });\n  const { addToast } = useToast();\n  const navigate = useNavigate();\n\n  const handleCheckout = (e: React.FormEvent) => {\n    e.preventDefault();\n    \n    const phoneRegex = /^(0|0098|\\+98)9\\d{9}$/;\n    if (!phoneRegex.test(formData.phone)) {\n      addToast(\'\331\204\330\267\331\201\330\247 \333\214\332\251 \330\264\331\205\330\247\330\261\331\207 \331\205\331\210\330\250\330\247\333\214\331\204 \331\205\330\271\330\252\330\250\330\261 \331\210\330\247\330\261\330\257 \332\251\331\206\333\214\330\257 (\331\205\330\253\330\247\331\204: 09123456789)\', \'error\');\n      return;\n    }\n\n    if (!formData.name || !formData.province || !formData.city || !formData.address) {\n      addToast(\'\331\204\330\267\331\201\330\247 \330\252\331\205\330\247\331\205 \331\201\333\214\331\204\330\257\331\207\330\247\333\214 \330\263\330\252\330\247\330\261\331\207\342\200\214\330\257\330\247\330\261 \330\261\330\247 \331\276\330\261 \332\251\331\206\333\214\330\257\', \'error\');\n      return;\n    }\n\n    addToast(\'\330\263\331\201\330\247\330\261\330\264 \330\264\331\205\330\247 \330\250\330\247 \331\205\331\210\331\201\331\202\333\214\330\252 \330\253\330\250\330\252 \330\264\330\257\', \'success\');\n    navigate(\'/profile\');\n  };\n\n  return (\n    <motion.div \n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ duration: 0.5, ease: \"easeOut\" }}\n      className=\"bg-white rounded-3xl p-6 lg:p-10 shadow-sm border border-gray-100\"\n    >\n       \n\n      <div className=\"flex items-center justify-between mb-8\">\n        <h1 className=\"text-3xl font-black text-gray-900\">\330\252\330\263\331\210\333\214\331\207 \330\255\330\263\330\247\330\250</h1>\n      </div>\n\n       {/* Stepper */}\n       <div className=\"flex items-center justify-between max-w-2xl mx-auto mb-12 relative\">\n         <div className=\"absolute top-1/2 left-0 right-0 h-1 bg-gray-200 -z-10 -translate-y-1/2\"></div>\n         <div className=\"absolute top-1/2 right-0 w-1/2 h-1 bg-orange-600 -z-10 -translate-y-1/2\"></div>\n         \n         <Link to=\"/cart\" className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-orange-600 text-white flex items-center justify-center font-bold\">\342\234\223</div>\n           <span className=\"text-sm font-bold text-orange-600\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257</span>\n         </Link>\n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-orange-600 text-white flex items-center justify-center font-bold\">\333\262</div>\n           <span className=\"text-sm font-bold text-orange-600\">\330\247\330\267\331\204\330\247\330\271\330\247\330\252 \330\247\330\261\330\263\330\247\331\204</span>\n         </div>\n         <div className=\"flex flex-col items-center gap-2 bg-white px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center font-bold\">\333\263</div>\n           <span className=\"text-sm font-medium text-gray-500\">\331\276\330\261\330\257\330\247\330\256\330\252</span>\n         </div>\n      </div>\n\n      <div className=\"flex flex-col lg:flex-row gap-8\">\n        {/* Forms */}\n        <form onSubmit={handleCheckout} className=\"w-full lg:w-2/3 space-y-8\">\n           {/* Section 1 */}\n           <div className=\"border border-gray-200 rounded-2xl p-6\">\n             <h2 className=\"text-xl font-bold text-gray-900 flex items-center gap-2 mb-6\">\n                <span className=\"text-orange-600\">\360\237\221\244</span> \330\247\330\267\331\204\330\247\330\271\330\247\330\252 \332\257\333\214\330\261\331\206\330\257\331\207 \331\210 \330\247\330\261\330\263\330\247\331\204\n             </h2>\n             \n             <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">\331\206\330\247\331\205 \331\210 \331\206\330\247\331\205 \330\256\330\247\331\206\331\210\330\247\330\257\332\257\333\214 *</label>\n                  <input type=\"text\" value={formData.name} onChange={e => setFormData({...formData, name: e.target.value})} className=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 focus:bg-white transition-colors\" placeholder=\"\331\205\330\253\330\247\331\204: \330\271\331\204\333\214 \331\205\330\255\331\205\330\257\333\214\" required />\n                </div>\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">\330\264\331\205\330\247\330\261\331\207 \331\205\331\210\330\250\330\247\333\214\331\204 *</label>\n                  <input type=\"tel\" value={formData.phone} onChange={e => setFormData({...formData, phone: e.target.value})} className=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 focus:bg-white transition-colors text-left dir-ltr\" placeholder=\"09123456789\" required />\n                </div>\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">\330\247\330\263\330\252\330\247\331\206 *</label>\n                  <select value={formData.province} onChange={e => setFormData({...formData, province: e.target.value})} className=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 focus:bg-white transition-colors text-gray-600\" required>\n                    <option value=\"\">\330\247\331\206\330\252\330\256\330\247\330\250 \330\247\330\263\330\252\330\247\331\206</option>\n                    <option value=\"\330\252\331\207\330\261\330\247\331\206\">\330\252\331\207\330\261\330\247\331\206</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">\330\264\331\207\330\261 *</label>\n                  <select value={formData.city} onChange={e => setFormData({...formData, city: e.target.value})} className=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 focus:bg-white transition-colors text-gray-600\" required>\n                    <option value=\"\">\330\247\331\206\330\252\330\256\330\247\330\250 \330\264\331\207\330\261</option>\n                    <option value=\"\330\252\331\207\330\261\330\247\331\206\">\330\252\331\207\330\261\330\247\331\206</option>\n                  </select>\n                </div>\n                <div className=\"md:col-span-2\">\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">\330\242\330\257\330\261\330\263 \332\251\330\247\331\205\331\204 *</label>\n                  <input type=\"text\" value={formData.address} onChange={e => setFormData({...formData, address: e.target.value})} className=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 focus:bg-white transition-colors\" placeholder=\"\330\256\333\214\330\247\330\250\330\247\331\206\330\214 \332\251\331\210\332\206\331\207\330\214 \331\276\331\204\330\247\332\251\330\214 \331\210\330\247\330\255\330\257\" required />\n                </div>\n             </div>\n           </div>\n\n           {/* Section 2 */}\n           <div className=\"border border-gray-200 rounded-2xl p-6\">\n             <h2 className=\"text-xl font-bold text-gray-900 flex items-center gap-2 mb-6\">\n                <span className=\"text-orange-600\">\360\237\223\246</span> \330\261\331\210\330\264 \330\247\330\261\330\263\330\247\331\204\n             </h2>\n             \n             <div className=\"space-y-4\">\n                <label className=\"flex items-center justify-between p-4 border border-orange-500 bg-orange-50 rounded-xl cursor-pointer\">\n                  <div className=\"flex items-center gap-3\">\n                    <input type=\"radio\" name=\"shipping\" className=\"w-4 h-4 text-orange-600\" defaultChecked />\n                    <div>\n                      <div className=\"font-bold text-gray-900\">\330\247\330\261\330\263\330\247\331\204 \330\263\330\261\333\214\330\271 (\331\276\330\263\330\252 \331\276\333\214\330\264\330\252\330\247\330\262)</div>\n                      <div className=\"text-xs text-gray-500\">\330\252\330\255\331\210\333\214\331\204 \330\250\333\214\331\206 \333\261 \330\252\330\247 \333\262 \330\261\331\210\330\262 \332\251\330\247\330\261\333\214</div>\n                    </div>\n                  </div>\n                  <div className=\"font-bold text-gray-900\">\333\266\333\271,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206</div>\n                </label>\n             </div>\n           </div>\n        </form>\n\n        {/* Order Summary */}\n        <div className=\"w-full lg:w-1/3\">\n           <div className=\"bg-gray-50 rounded-2xl p-6 border border-gray-200 sticky top-28\">\n             <h3 className=\"font-black text-gray-900 text-xl mb-6\">\330\256\331\204\330\247\330\265\331\207 \330\263\331\201\330\247\330\261\330\264</h3>\n             \n             <div className=\"space-y-4 mb-6 text-sm\">\n               <div className=\"flex justify-between text-gray-600\">\n                 <span>\330\254\331\205\330\271 \332\251\331\204 \332\251\330\247\331\204\330\247\331\207\330\247</span>\n                 <span className=\"font-medium text-gray-900\">\333\266\333\271\333\260,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206</span>\n               </div>\n               <div className=\"flex justify-between text-gray-600\">\n                 <span>\331\207\330\262\333\214\331\206\331\207 \330\247\330\261\330\263\330\247\331\204</span>\n                 <span className=\"font-medium text-gray-900\">\333\266\333\271,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206</span>\n               </div>\n             </div>\n             \n             <div className=\"border-t border-gray-200 pt-6 mb-6\">\n               <div className=\"flex justify-between items-center mb-2\">\n                 <span className=\"font-bold text-gray-900\">\331\205\330\250\331\204\330\272 \331\202\330\247\330\250\331\204 \331\276\330\261\330\257\330\247\330\256\330\252</span>\n                 <span className=\"text-2xl font-black text-orange-600\">\333\267\333\265\333\271,\333\260\333\260\333\260 <span className=\"text-sm font-normal text-gray-600\">\330\252\331\210\331\205\330\247\331\206</span></span>\n               </div>\n             </div>\n             \n             <button onClick={handleCheckout} className=\"block w-full bg-orange-600 hover:bg-orange-700 text-white text-center font-bold py-4 rounded-xl transition-colors mb-4\">\n               \330\253\330\250\330\252 \330\263\331\201\330\247\330\261\330\264 \331\210 \331\276\330\261\330\257\330\247\330\256\330\252\n             </button>\n           </div>\n        </div>\n      </div>\n    </motion.div>\n  );\n}"
      replacement_content: "import React, { useState } from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useCart } from \'../contexts/CartContext\';\nimport { useToast } from \'../contexts/ToastContext\';\nimport { motion } from \'motion/react\';\nimport EmptyState from \'../components/EmptyState\';\nimport { ShoppingCart, Truck, CreditCard, ShieldCheck, CheckCircle, MapPin } from \'lucide-react\';\n\nconst FREE_SHIPPING_THRESHOLD = 2000000;\n\nexport default function Checkout() {\n  const { cart, cartTotal, clearCart } = useCart();\n  const { addToast } = useToast();\n  const navigate = useNavigate();\n\n  const [formData, setFormData] = useState({\n    name: \'\',\n    phone: \'\',\n    province: \'\330\252\331\207\330\261\330\247\331\206\',\n    city: \'\330\252\331\207\330\261\330\247\331\206\',\n    address: \'\',\n    postalCode: \'\',\n    notes: \'\',\n    paymentMethod: \'online\' as \'online\' | \'cod\',\n    shippingMethod: \'express\' as \'express\' | \'standard\'\n  });\n\n  const isFreeShipping = cartTotal >= FREE_SHIPPING_THRESHOLD;\n  const shippingFee = isFreeShipping ? 0 : (formData.shippingMethod === \'express\' ? 69000 : 39000);\n  const finalPayable = cartTotal + shippingFee;\n\n  if (cart.length === 0) {\n    return (\n      <motion.div\n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.5 }}\n      >\n        <EmptyState \n          icon={<ShoppingCart className=\"h-16 w-16 text-gray-300\" />}\n          title=\"\330\263\330\250\330\257 \330\256\330\261\333\214\330\257 \330\264\331\205\330\247 \330\256\330\247\331\204\333\214 \330\247\330\263\330\252!\"\n          description=\"\330\250\330\261\330\247\333\214 \330\253\330\250\330\252 \330\263\331\201\330\247\330\261\330\264 \330\247\330\250\330\252\330\257\330\247 \330\250\330\247\333\214\330\257 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\333\214 \330\261\330\247 \330\250\331\207 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257 \330\247\330\266\330\247\331\201\331\207 \332\251\331\206\333\214\330\257.\"\n          actionText=\"\331\205\330\264\330\247\331\207\330\257\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\"\n          actionLink=\"/products\"\n        />\n      </motion.div>\n    );\n  }\n\n  const handleCheckout = (e: React.FormEvent) => {\n    e.preventDefault();\n    \n    const phoneRegex = /^(0|0098|\\+98)?9\\d{9}$/;\n    if (!phoneRegex.test(formData.phone)) {\n      addToast(\'\331\204\330\267\331\201\330\247 \333\214\332\251 \330\264\331\205\330\247\330\261\331\207 \331\205\331\210\330\250\330\247\333\214\331\204 \331\205\330\271\330\252\330\250\330\261 \331\210\330\247\330\261\330\257 \332\251\331\206\333\214\330\257 (\331\205\330\253\330\247\331\204: 09123456789)\', \'error\');\n      return;\n    }\n\n    if (!formData.name.trim() || !formData.province || !formData.city || !formData.address.trim()) {\n      addToast(\'\331\204\330\267\331\201\330\247 \330\252\331\205\330\247\331\205\333\214 \330\247\330\267\331\204\330\247\330\271\330\247\330\252 \330\266\330\261\331\210\330\261\333\214 \332\257\333\214\330\261\331\206\330\257\331\207 \330\261\330\247 \330\252\332\251\331\205\333\214\331\204 \332\251\331\206\333\214\330\257\', \'error\');\n      return;\n    }\n\n    const orderId = `ORD-${Math.floor(100000 + Math.random() * 900000)}`;\n    const today = new Date();\n    const dateStr = new Intl.DateTimeFormat(\'fa-IR\', { year: \'numeric\', month: \'long\', day: \'numeric\' }).format(today);\n\n    const newOrder = {\n      id: orderId,\n      date: dateStr,\n      status: \'processing\',\n      statusText: \'\330\257\330\261 \330\255\330\247\331\204 \331\276\330\261\330\257\330\247\330\262\330\264\',\n      total: finalPayable,\n      subtotal: cartTotal,\n      shippingFee,\n      paymentMethod: formData.paymentMethod === \'online\' ? \'\331\276\330\261\330\257\330\247\330\256\330\252 \330\242\331\206\331\204\330\247\333\214\331\206\' : \'\331\276\330\261\330\257\330\247\330\256\330\252 \330\257\330\261 \331\205\330\255\331\204\',\n      recipient: {\n        name: formData.name,\n        phone: formData.phone,\n        address: `${formData.province}\330\214 ${formData.city}\330\214 ${formData.address}`,\n        postalCode: formData.postalCode\n      },\n      items: cart.map(item => ({\n        id: item.id,\n        title: item.title,\n        price: item.price,\n        image: item.image,\n        qty: item.quantity,\n        brand: item.brand\n      }))\n    };\n\n    try {\n      const existingOrders = JSON.parse(localStorage.getItem(\'user_orders\') || \'[]\');\n      localStorage.setItem(\'user_orders\', JSON.stringify([newOrder, ...existingOrders]));\n    } catch (e) {\n      console.warn(\'Failed to save order to localStorage\', e);\n    }\n\n    clearCart();\n    addToast(`\330\263\331\201\330\247\330\261\330\264 \330\264\331\205\330\247 \330\250\330\247 \332\251\330\257 ${orderId} \330\250\330\247 \331\205\331\210\331\201\331\202\333\214\330\252 \330\253\330\250\330\252 \330\264\330\257`, \'success\');\n    navigate(\'/profile\');\n  };\n\n  return (\n    <motion.div \n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ duration: 0.5, ease: \"easeOut\" }}\n      className=\"bg-white dark:bg-gray-900 rounded-3xl p-6 lg:p-10 shadow-sm border border-gray-100 dark:border-gray-800 transition-colors\"\n    >\n      <div className=\"flex items-center justify-between mb-8\">\n        <h1 className=\"text-2xl sm:text-3xl font-black text-gray-900 dark:text-gray-100\">\330\252\330\263\331\210\333\214\331\207 \330\255\330\263\330\247\330\250 \331\210 \331\276\330\261\330\257\330\247\330\256\330\252</h1>\n      </div>\n\n       {/* Stepper */}\n       <div className=\"flex items-center justify-between max-w-2xl mx-auto mb-12 relative\">\n         <div className=\"absolute top-1/2 left-0 right-0 h-1 bg-gray-200 dark:bg-gray-700 -z-10 -translate-y-1/2\"></div>\n         <div className=\"absolute top-1/2 right-0 w-1/2 h-1 bg-orange-600 -z-10 -translate-y-1/2\"></div>\n         \n         <Link to=\"/cart\" className=\"flex flex-col items-center gap-2 bg-white dark:bg-gray-900 px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-orange-600 text-white flex items-center justify-center font-bold\">\342\234\223</div>\n           <span className=\"text-xs sm:text-sm font-bold text-orange-600\">\330\263\330\250\330\257 \330\256\330\261\333\214\330\257</span>\n         </Link>\n         <div className=\"flex flex-col items-center gap-2 bg-white dark:bg-gray-900 px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-orange-600 text-white flex items-center justify-center font-bold\">\333\262</div>\n           <span className=\"text-xs sm:text-sm font-bold text-orange-600\">\330\247\330\267\331\204\330\247\330\271\330\247\330\252 \330\247\330\261\330\263\330\247\331\204</span>\n         </div>\n         <div className=\"flex flex-col items-center gap-2 bg-white dark:bg-gray-900 px-4\">\n           <div className=\"w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-500 flex items-center justify-center font-bold\">\333\263</div>\n           <span className=\"text-xs sm:text-sm font-medium text-gray-500\">\330\252\330\247\333\214\333\214\330\257 \331\210 \331\276\330\261\330\257\330\247\330\256\330\252</span>\n         </div>\n      </div>\n\n      <div className=\"flex flex-col lg:flex-row gap-8\">\n        {/* Form Sections */}\n        <form onSubmit={handleCheckout} className=\"w-full lg:w-2/3 space-y-8\">\n           {/* Section 1: Recipient details */}\n           <div className=\"border border-gray-200 dark:border-gray-800 rounded-2xl p-6 bg-gray-50/50 dark:bg-gray-800/30\">\n             <h2 className=\"text-lg font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2 mb-6\">\n                <MapPin className=\"h-5 w-5 text-orange-600\" /> \330\247\330\267\331\204\330\247\330\271\330\247\330\252 \332\257\333\214\330\261\331\206\330\257\331\207 \331\210 \330\242\330\257\330\261\330\263 \330\252\330\255\331\210\333\214\331\204\n             </h2>\n             \n             <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"block text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\">\331\206\330\247\331\205 \331\210 \331\206\330\247\331\205 \330\256\330\247\331\206\331\210\330\247\330\257\332\257\333\214 \332\257\333\214\330\261\331\206\330\257\331\207 *</label>\n                  <input \n                    type=\"text\" \n                    value={formData.name} \n                    onChange={e => setFormData({...formData, name: e.target.value})} \n                    className=\"w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 transition-colors\" \n                    placeholder=\"\331\205\330\253\330\247\331\204: \330\271\331\204\333\214 \331\205\330\255\331\205\330\257\333\214\" \n                    required \n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\">\330\264\331\205\330\247\330\261\331\207 \331\207\331\205\330\261\330\247\331\207 \332\257\333\214\330\261\331\206\330\257\331\207 *</label>\n                  <input \n                    type=\"tel\" \n                    value={formData.phone} \n                    onChange={e => setFormData({...formData, phone: e.target.value})} \n                    className=\"w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 transition-colors text-left dir-ltr\" \n                    placeholder=\"09123456789\" \n                    required \n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\">\330\247\330\263\330\252\330\247\331\206 *</label>\n                  <select \n                    value={formData.province} \n                    onChange={e => setFormData({...formData, province: e.target.value})} \n                    className=\"w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 transition-colors\" \n                    required\n                  >\n                    <option value=\"\330\252\331\207\330\261\330\247\331\206\">\330\252\331\207\330\261\330\247\331\206</option>\n                    <option value=\"\330\247\330\265\331\201\331\207\330\247\331\206\">\330\247\330\265\331\201\331\207\330\247\331\206</option>\n                    <option value=\"\330\256\330\261\330\247\330\263\330\247\331\206 \330\261\330\266\331\210\333\214\">\330\256\330\261\330\247\330\263\330\247\331\206 \330\261\330\266\331\210\333\214</option>\n                    <option value=\"\331\201\330\247\330\261\330\263\">\331\201\330\247\330\261\330\263</option>\n                    <option value=\"\330\242\330\260\330\261\330\250\330\247\333\214\330\254\330\247\331\206 \330\264\330\261\331\202\333\214\">\330\242\330\260\330\261\330\250\330\247\333\214\330\254\330\247\331\206 \330\264\330\261\331\202\333\214</option>\n                    <option value=\"\330\247\331\204\330\250\330\261\330\262\">\330\247\331\204\330\250\330\261\330\262</option>\n                    <option value=\"\331\205\330\247\330\262\331\206\330\257\330\261\330\247\331\206\">\331\205\330\247\330\262\331\206\330\257\330\261\330\247\331\206</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\">\330\264\331\207\330\261 *</label>\n                  <input \n                    type=\"text\" \n                    value={formData.city} \n                    onChange={e => setFormData({...formData, city: e.target.value})} \n                    className=\"w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 transition-colors\" \n                    placeholder=\"\331\205\330\253\330\247\331\204: \330\252\331\207\330\261\330\247\331\206\" \n                    required \n                  />\n                </div>\n                <div className=\"md:col-span-2\">\n                  <label className=\"block text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\">\330\242\330\257\330\261\330\263 \331\276\330\263\330\252\333\214 \332\251\330\247\331\205\331\204 *</label>\n                  <input \n                    type=\"text\" \n                    value={formData.address} \n                    onChange={e => setFormData({...formData, address: e.target.value})} \n                    className=\"w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 transition-colors\" \n                    placeholder=\"\330\256\333\214\330\247\330\250\330\247\331\206 \330\247\330\265\331\204\333\214\330\214 \332\251\331\210\332\206\331\207\330\214 \331\276\331\204\330\247\332\251\330\214 \331\210\330\247\330\255\330\257\" \n                    required \n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\">\332\251\330\257 \331\276\330\263\330\252\333\214 (\330\247\330\256\330\252\333\214\330\247\330\261\333\214)</label>\n                  <input \n                    type=\"text\" \n                    value={formData.postalCode} \n                    onChange={e => setFormData({...formData, postalCode: e.target.value})} \n                    className=\"w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 transition-colors text-left dir-ltr\" \n                    placeholder=\"1234567890\" \n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs sm:text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\">\330\252\331\210\330\266\333\214\330\255\330\247\330\252 \330\252\330\255\331\210\333\214\331\204 (\330\247\330\256\330\252\333\214\330\247\330\261\333\214)</label>\n                  <input \n                    type=\"text\" \n                    value={formData.notes} \n                    onChange={e => setFormData({...formData, notes: e.target.value})} \n                    className=\"w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-xl px-4 py-3 focus:outline-none focus:border-orange-500 transition-colors\" \n                    placeholder=\"\331\205\330\253\331\204\330\247 \330\252\330\255\331\210\333\214\331\204 \330\250\331\207 \331\206\332\257\331\207\330\250\330\247\331\206\333\214\" \n                  />\n                </div>\n             </div>\n           </div>\n\n           {/* Section 2: Shipping Method */}\n           <div className=\"border border-gray-200 dark:border-gray-800 rounded-2xl p-6 bg-gray-50/50 dark:bg-gray-800/30\">\n             <h2 className=\"text-lg font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2 mb-6\">\n                <Truck className=\"h-5 w-5 text-orange-600\" /> \330\264\333\214\331\210\331\207 \330\247\330\261\330\263\330\247\331\204\n             </h2>\n             \n             <div className=\"space-y-4\">\n                <label className={`flex items-center justify-between p-4 border rounded-xl cursor-pointer transition-all ${\n                  formData.shippingMethod === \'express\' ? \'border-orange-500 bg-orange-50/50 dark:bg-orange-950/20\' : \'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800\'\n                }`}>\n                  <div className=\"flex items-center gap-3\">\n                    <input \n                      type=\"radio\" \n                      name=\"shippingMethod\" \n                      checked={formData.shippingMethod === \'express\'} \n                      onChange={() => setFormData({...formData, shippingMethod: \'express\'})}\n                      className=\"w-4 h-4 text-orange-600 focus:ring-orange-500\" \n                    />\n                    <div>\n                      <div className=\"font-bold text-gray-900 dark:text-gray-100 text-sm\">\330\247\330\261\330\263\330\247\331\204 \331\276\333\214\330\264\330\252\330\247\330\262 \330\263\330\261\333\214\330\271 (\333\261 \330\252\330\247 \333\262 \330\261\331\210\330\262 \332\251\330\247\330\261\333\214)</div>\n                      <div className=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">\330\247\330\261\330\263\330\247\331\204 \330\247\332\251\330\263\331\276\330\261\330\263 \331\205\330\263\330\252\331\202\333\214\331\205 \330\250\330\247 \331\276\330\264\330\252\333\214\330\250\330\247\331\206\333\214 \331\204\330\255\330\270\331\207\342\200\214\330\247\333\214</div>\n                    </div>\n                  </div>\n                  <div className=\"font-extrabold text-orange-600 dark:text-orange-400 text-sm\">\n                    {isFreeShipping ? \'\330\261\330\247\333\214\332\257\330\247\331\206\' : \'\333\266\333\271,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206\'}\n                  </div>\n                </label>\n\n                <label className={`flex items-center justify-between p-4 border rounded-xl cursor-pointer transition-all ${\n                  formData.shippingMethod === \'standard\' ? \'border-orange-500 bg-orange-50/50 dark:bg-orange-950/20\' : \'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800\'\n                }`}>\n                  <div className=\"flex items-center gap-3\">\n                    <input \n                      type=\"radio\" \n                      name=\"shippingMethod\" \n                      checked={formData.shippingMethod === \'standard\'} \n                      onChange={() => setFormData({...formData, shippingMethod: \'standard\'})}\n                      className=\"w-4 h-4 text-orange-600 focus:ring-orange-500\" \n                    />\n                    <div>\n                      <div className=\"font-bold text-gray-900 dark:text-gray-100 text-sm\">\330\247\330\261\330\263\330\247\331\204 \330\263\331\201\330\247\330\261\330\264\333\214 \330\247\331\202\330\252\330\265\330\247\330\257\333\214 (\333\263 \330\252\330\247 \333\265 \330\261\331\210\330\262 \332\251\330\247\330\261\333\214)</div>\n                      <div className=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">\330\252\330\255\331\210\333\214\331\204 \330\252\331\210\330\263\330\267 \331\276\330\263\330\252 \330\263\331\201\330\247\330\261\330\264\333\214 \332\251\330\264\331\210\330\261\333\214</div>\n                    </div>\n                  </div>\n                  <div className=\"font-extrabold text-orange-600 dark:text-orange-400 text-sm\">\n                    {isFreeShipping ? \'\330\261\330\247\333\214\332\257\330\247\331\206\' : \'\333\263\333\271,\333\260\333\260\333\260 \330\252\331\210\331\205\330\247\331\206\'}\n                  </div>\n                </label>\n             </div>\n           </div>\n\n           {/* Section 3: Payment Method */}\n           <div className=\"border border-gray-200 dark:border-gray-800 rounded-2xl p-6 bg-gray-50/50 dark:bg-gray-800/30\">\n             <h2 className=\"text-lg font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2 mb-6\">\n                <CreditCard className=\"h-5 w-5 text-orange-600\" /> \330\261\331\210\330\264 \331\276\330\261\330\257\330\247\330\256\330\252\n             </h2>\n             \n             <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <label className={`flex items-center gap-3 p-4 border rounded-xl cursor-pointer transition-all ${\n                  formData.paymentMethod === \'online\' ? \'border-orange-500 bg-orange-50/50 dark:bg-orange-950/20\' : \'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800\'\n                }`}>\n                  <input \n                    type=\"radio\" \n                    name=\"paymentMethod\" \n                    checked={formData.paymentMethod === \'online\'} \n                    onChange={() => setFormData({...formData, paymentMethod: \'online\'})}\n                    className=\"w-4 h-4 text-orange-600 focus:ring-orange-500\" \n                  />\n                  <div>\n                    <div className=\"font-bold text-gray-900 dark:text-gray-100 text-sm\">\331\276\330\261\330\257\330\247\330\256\330\252 \330\247\333\214\331\206\330\252\330\261\331\206\330\252\333\214 (\330\257\330\261\332\257\330\247\331\207 \330\250\330\247\331\206\332\251\333\214)</div>\n                    <div className=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">\331\276\330\261\330\257\330\247\330\256\330\252 \330\242\331\206\331\204\330\247\333\214\331\206 \330\247\331\205\331\206 \330\250\330\247 \330\252\331\205\330\247\331\205\333\214 \332\251\330\247\330\261\330\252\342\200\214\331\207\330\247\333\214 \330\264\330\252\330\247\330\250</div>\n                  </div>\n                </label>\n\n                <label className={`flex items-center gap-3 p-4 border rounded-xl cursor-pointer transition-all ${\n                  formData.paymentMethod === \'cod\' ? \'border-orange-500 bg-orange-50/50 dark:bg-orange-950/20\' : \'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800\'\n                }`}>\n                  <input \n                    type=\"radio\" \n                    name=\"paymentMethod\" \n                    checked={formData.paymentMethod === \'cod\'} \n                    onChange={() => setFormData({...formData, paymentMethod: \'cod\'})}\n                    className=\"w-4 h-4 text-orange-600 focus:ring-orange-500\" \n                  />\n                  <div>\n                    <div className=\"font-bold text-gray-900 dark:text-gray-100 text-sm\">\331\276\330\261\330\257\330\247\330\256\330\252 \330\257\330\261 \331\205\330\255\331\204 (\332\251\330\247\330\261\330\252\330\256\331\210\330\247\331\206 \331\205\330\243\331\205\331\210\330\261 \331\276\330\263\330\252)</div>\n                    <div className=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">\330\252\330\263\331\210\333\214\331\207 \330\255\333\214\331\206 \330\252\330\255\331\210\333\214\331\204 \331\205\330\261\330\263\331\210\331\204\331\207 \330\257\330\261 \331\205\331\202\330\265\330\257</div>\n                  </div>\n                </label>\n             </div>\n           </div>\n        </form>\n\n        {/* Order Summary Box */}\n        <div className=\"w-full lg:w-1/3\">\n           <div className=\"bg-gray-50 dark:bg-gray-800/80 rounded-2xl p-6 border border-gray-200 dark:border-gray-700 sticky top-28\">\n             <h3 className=\"font-black text-gray-900 dark:text-gray-100 text-xl mb-6\">\330\256\331\204\330\247\330\265\331\207 \330\247\331\202\331\204\330\247\331\205 \330\263\331\201\330\247\330\261\330\264 ({cart.length.toLocaleString(\'fa-IR\')} \332\251\330\247\331\204\330\247)</h3>\n             \n             {/* Product list preview */}\n             <div className=\"max-h-56 overflow-y-auto mb-6 divide-y divide-gray-100 dark:divide-gray-700 pl-1\">\n               {cart.map((item) => (\n                 <div key={item.id} className=\"py-3 flex items-center gap-3\">\n                   <img src={item.image} alt={item.title} className=\"w-12 h-12 object-contain bg-white rounded-lg p-1 border border-gray-100 shrink-0\" />\n                   <div className=\"grow min-w-0\">\n                     <div className=\"text-xs font-semibold text-gray-800 dark:text-gray-200 truncate\">{item.title}</div>\n                     <div className=\"text-[11px] text-gray-500 dark:text-gray-400 mt-0.5\">\n                       {item.quantity.toLocaleString(\'fa-IR\')} \330\271\330\257\330\257 \303\227 {item.price.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206\n                     </div>\n                   </div>\n                 </div>\n               ))}\n             </div>\n\n             <div className=\"space-y-3 mb-6 text-sm border-t border-gray-200 dark:border-gray-700 pt-4\">\n               <div className=\"flex justify-between text-gray-600 dark:text-gray-400\">\n                 <span>\330\254\331\205\330\271 \332\251\331\204 \332\251\330\247\331\204\330\247\331\207\330\247</span>\n                 <span className=\"font-medium text-gray-900 dark:text-gray-100\">{cartTotal.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206</span>\n               </div>\n               <div className=\"flex justify-between text-gray-600 dark:text-gray-400\">\n                 <span>\331\207\330\262\333\214\331\206\331\207 \330\247\330\261\330\263\330\247\331\204</span>\n                 <span className=\"font-medium text-gray-900 dark:text-gray-100\">\n                   {shippingFee === 0 ? <span className=\"text-emerald-600 font-bold\">\330\261\330\247\333\214\332\257\330\247\331\206</span> : `${shippingFee.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206`}\n                 </span>\n               </div>\n             </div>\n             \n             <div className=\"border-t border-gray-200 dark:border-gray-700 pt-4 mb-6\">\n               <div className=\"flex justify-between items-center mb-1\">\n                 <span className=\"font-bold text-gray-900 dark:text-gray-100\">\331\205\330\250\331\204\330\272 \331\206\331\207\330\247\333\214\333\214 \331\202\330\247\330\250\331\204 \331\276\330\261\330\257\330\247\330\256\330\252</span>\n                 <span className=\"text-2xl font-black text-orange-600 dark:text-orange-400\">\n                   {finalPayable.toLocaleString(\'fa-IR\')} <span className=\"text-xs font-normal text-gray-500\">\330\252\331\210\331\205\330\247\331\206</span>\n                 </span>\n               </div>\n             </div>\n             \n             <button \n               onClick={handleCheckout} \n               className=\"w-full bg-orange-600 hover:bg-orange-700 text-white font-bold py-4 rounded-xl transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 active:scale-[0.99]\"\n             >\n               <ShieldCheck className=\"h-5 w-5\" />\n               \331\206\331\207\330\247\333\214\333\214\342\200\214\330\263\330\247\330\262\333\214 \331\210 \330\253\330\250\330\252 \330\263\331\201\330\247\330\261\330\264\n             </button>\n             \n             <div className=\"mt-4 text-center text-xs text-gray-500 dark:text-gray-400 flex items-center justify-center gap-1\">\n               <CheckCircle className=\"h-3.5 w-3.5 text-emerald-500\" />\n               \330\252\330\266\331\205\333\214\331\206 \333\267 \330\261\331\210\330\262 \330\250\330\247\330\262\332\257\330\264\330\252 \332\251\330\247\331\204\330\247 \331\210 \330\247\330\265\330\247\331\204\330\252 \330\263\331\206\330\254\333\214\n             </div>\n           </div>\n        </div>\n      </div>\n    </motion.div>\n  );\n}\n"
    }
