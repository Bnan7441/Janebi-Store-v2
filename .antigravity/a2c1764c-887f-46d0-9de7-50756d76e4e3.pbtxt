      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { Package, ChevronLeft, CheckCircle, Clock, Heart, Printer, Search, XCircle } from \'lucide-react\';\nimport { useToast } from \'../contexts/ToastContext\';\nimport { motion } from \'motion/react\';\nimport { OrderCardSkeleton } from \'../components/Skeletons\';\n\nconst mockOrders = [\n  {\n    id: \'ORD-847291\',\n    date: \'\333\261\333\265 \331\205\331\207\330\261 \333\261\333\264\333\260\333\262\',\n    status: \'delivered\',\n    statusText: \'\330\252\330\255\331\210\333\214\331\204 \330\257\330\247\330\257\331\207 \330\264\330\257\331\207\',\n    total: 1380000,\n    items: [\n      { id: 1, title: \'\330\264\330\247\330\261\332\230\330\261 \330\257\333\214\331\210\330\247\330\261\333\214 \333\262\333\265 \331\210\330\247\330\252 USB-C\', image: \'https://placehold.co/100x100?text=Charger\', qty: 1, price: 980000 },\n      { id: 2, title: \'\332\251\330\247\330\250\331\204 \330\252\330\250\330\257\333\214\331\204 USB-C \330\250\331\207 USB-C\', image: \'https://placehold.co/100x100?text=Cable\', qty: 2, price: 200000 }\n    ],\n    recipient: { name: \'\330\271\331\204\333\214 \331\205\330\255\331\205\330\257\333\214\', address: \'\330\252\331\207\330\261\330\247\331\206\330\214 \330\256\333\214\330\247\330\250\330\247\331\206 \330\242\330\262\330\247\330\257\333\214\330\214 \331\276\331\204\330\247\332\251 \333\261\333\262\' }\n  },\n  {\n    id: \'ORD-739281\',\n    date: \'\333\262 \330\264\331\207\330\261\333\214\331\210\330\261 \333\261\333\264\333\260\333\262\',\n    status: \'processing\',\n    statusText: \'\330\257\330\261 \330\255\330\247\331\204 \331\276\330\261\330\257\330\247\330\262\330\264\',\n    total: 4500000,\n    items: [\n      { id: 6, title: \'\331\207\331\206\330\257\330\262\331\201\330\261\333\214 \330\250\333\214 \330\263\333\214\331\205 \330\263\330\247\331\205\330\263\331\210\331\206\332\257\', image: \'https://placehold.co/100x100?text=Buds\', qty: 1, price: 4500000 }\n    ],\n    recipient: { name: \'\330\271\331\204\333\214 \331\205\330\255\331\205\330\257\333\214\', address: \'\330\252\331\207\330\261\330\247\331\206\330\214 \330\256\333\214\330\247\330\250\330\247\331\206 \331\210\331\204\333\214\330\271\330\265\330\261\330\214 \330\250\330\261\330\254 \330\242\331\201\330\252\330\247\330\250\' }\n  }\n];\n\nexport default function OrderHistory() {\n  const { addToast } = useToast();\n  const [loading, setLoading] = useState(true);\n  const [orders, setOrders] = useState<any[]>([]);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  useEffect(() => {\n    try {\n      const savedOrders = localStorage.getItem(\'user_orders\');\n      if (savedOrders) {\n        setOrders(JSON.parse(savedOrders));\n      } else {\n        setOrders(mockOrders);\n      }\n    } catch (e) {\n      setOrders(mockOrders);\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  const handlePrint = (orderId: string) => {\n    addToast(`\331\201\330\247\332\251\330\252\331\210\330\261 \330\263\331\201\330\247\330\261\330\264 ${orderId} \330\257\330\261 \330\255\330\247\331\204 \330\242\331\205\330\247\330\257\331\207\342\200\214\330\263\330\247\330\262\333\214 \330\250\330\261\330\247\333\214 \332\206\330\247\331\276 \330\247\330\263\330\252...`, \'info\');\n    setTimeout(() => {\n      window.print();\n    }, 300);\n  };\n\n  const handleCancelOrder = (orderId: string) => {\n    const updated = orders.map(o => o.id === orderId ? { ...o, status: \'cancelled\', statusText: \'\331\204\330\272\331\210 \330\264\330\257\331\207\' } : o);\n    setOrders(updated);\n    try {\n      localStorage.setItem(\'user_orders\', JSON.stringify(updated));\n    } catch(e) {}\n    addToast(`\330\263\331\201\330\247\330\261\330\264 ${orderId} \330\250\330\247 \331\205\331\210\331\201\331\202\333\214\330\252 \331\204\330\272\331\210 \330\264\330\257`, \'info\');\n  };\n\n  const filteredOrders = orders.filter(o => \n    o.id.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    o.items.some((i: any) => i.title.includes(searchQuery))\n  );\n\n  return (\n    <motion.div \n      initial={{ opacity: 0 }}\n      animate={{ opacity: 1 }}\n      transition={{ duration: 0.4 }}\n    >\n      <div className=\"flex flex-col lg:flex-row gap-8\">\n        {/* Sidebar Profile Menu */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.4, delay: 0.1 }}\n          className=\"w-full lg:w-1/4 print:hidden\"\n        >\n          <div className=\"bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-800 p-6 sticky top-28 shadow-sm transition-colors\">\n            <div className=\"flex items-center gap-4 mb-8 pb-6 border-b border-gray-100 dark:border-gray-800\">\n              <div className=\"w-14 h-14 bg-orange-100 dark:bg-orange-950/50 text-orange-600 dark:text-orange-400 rounded-full flex items-center justify-center text-xl font-bold\">\360\237\221\244</div>\n              <div>\n                <div className=\"font-bold text-gray-900 dark:text-gray-100\">\330\271\331\204\333\214 \331\205\330\255\331\205\330\257\333\214</div>\n                <div className=\"text-sm text-gray-500 dark:text-gray-400\">\333\260\333\271\333\261\333\262\333\263\333\264\333\265\333\266\333\267\333\270\333\271</div>\n              </div>\n            </div>\n            \n            <nav className=\"space-y-2\">\n              <Link to=\"/profile\" className=\"flex items-center justify-between p-3 rounded-xl bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-medium\">\n                <div className=\"flex items-center gap-3\">\n                  <Package className=\"h-5 w-5\" />\n                  \330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \331\205\331\206\n                </div>\n                <ChevronLeft className=\"h-4 w-4\" />\n              </Link>\n              <Link to=\"/wishlist\" className=\"flex items-center justify-between p-3 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors\">\n                <div className=\"flex items-center gap-3\">\n                  <Heart className=\"h-5 w-5\" />\n                  \330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247\n                </div>\n              </Link>\n            </nav>\n          </div>\n        </motion.div>\n\n        {/* Main Content */}\n        <div className=\"w-full lg:w-3/4\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6\">\n            <h1 className=\"text-2xl font-black text-gray-900 dark:text-gray-100\">\330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \331\205\331\206 ({filteredOrders.length.toLocaleString(\'fa-IR\')})</h1>\n            \n            <div className=\"relative w-full sm:w-72\">\n              <input \n                type=\"text\" \n                placeholder=\"\330\254\330\263\330\252\330\254\331\210\333\214 \332\251\330\257 \330\263\331\201\330\247\330\261\330\264 \333\214\330\247 \332\251\330\247\331\204\330\247...\" \n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className=\"w-full px-4 py-2.5 pr-10 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 text-xs sm:text-sm rounded-xl focus:outline-none focus:border-orange-500\"\n              />\n              <Search className=\"h-4 w-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n            </div>\n          </div>\n\n          <div className=\"space-y-6\">\n            {loading ? (\n              Array.from({ length: 2 }).map((_, idx) => (\n                <OrderCardSkeleton key={idx} />\n              ))\n            ) : filteredOrders.length === 0 ? (\n              <div className=\"text-center py-12 bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800\">\n                <Package className=\"h-12 w-12 mx-auto text-gray-300 dark:text-gray-600 mb-3\" />\n                <p className=\"text-gray-500 dark:text-gray-400 font-medium\">\331\207\333\214\332\206 \330\263\331\201\330\247\330\261\330\264\333\214 \333\214\330\247\331\201\330\252 \331\206\330\264\330\257</p>\n              </div>\n            ) : (\n              filteredOrders.map((order) => (\n                <div key={order.id} className=\"bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden shadow-sm transition-colors\">\n                  <div className=\"bg-gray-50 dark:bg-gray-800/60 p-4 sm:p-6 border-b border-gray-200 dark:border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                    <div className=\"flex flex-wrap items-center gap-4 sm:gap-6\">\n                      <div>\n                        <div className=\"text-xs text-gray-500 dark:text-gray-400 mb-0.5\">\330\264\331\205\330\247\330\261\331\207 \331\276\333\214\332\257\333\214\330\261\333\214</div>\n                        <div className=\"font-extrabold text-gray-900 dark:text-gray-100 text-sm\">{order.id}</div>\n                      </div>\n                      <div>\n                        <div className=\"text-xs text-gray-500 dark:text-gray-400 mb-0.5\">\330\252\330\247\330\261\333\214\330\256 \330\253\330\250\330\252</div>\n                        <div className=\"font-bold text-gray-800 dark:text-gray-200 text-xs sm:text-sm\">{order.date}</div>\n                      </div>\n                      <div>\n                        <div className=\"text-xs text-gray-500 dark:text-gray-400 mb-0.5\">\331\205\330\250\331\204\330\272 \331\276\330\261\330\257\330\247\330\256\330\252 \330\264\330\257\331\207</div>\n                        <div className=\"font-bold text-orange-600 dark:text-orange-400 text-xs sm:text-sm\">{order.total.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206</div>\n                      </div>\n                    </div>\n                    \n                    <div className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold ${\n                      order.status === \'delivered\' ? \'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-400\' :\n                      order.status === \'cancelled\' ? \'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-400\' :\n                      \'bg-orange-50 text-orange-700 dark:bg-orange-950/40 dark:text-orange-400\'\n                    }`}>\n                       {order.status === \'delivered\' ? <CheckCircle className=\"h-4 w-4\" /> : \n                        order.status === \'cancelled\' ? <XCircle className=\"h-4 w-4\" /> : \n                        <Clock className=\"h-4 w-4\" />}\n                       {order.statusText}\n                    </div>\n                  </div>\n                  \n                  <div className=\"p-4 sm:p-6 print:border-none print:shadow-none\">\n                    <div className=\"flex flex-col gap-4 mb-6\">\n                      {order.items.map((item: any, idx: number) => (\n                        <div key={idx} className=\"flex items-center gap-4 py-2 border-b border-gray-100 dark:border-gray-800 last:border-0\">\n                          <div className=\"relative w-16 h-16 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 flex items-center justify-center p-2 shrink-0\">\n                            <img src={item.image} alt={item.title} className=\"max-w-full max-h-full object-contain mix-blend-multiply dark:mix-blend-normal\" />\n                            <span className=\"absolute -top-2 -right-2 bg-gray-800 dark:bg-gray-700 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full font-bold\">\n                              {item.qty}\n                            </span>\n                          </div>\n                          <div className=\"grow\">\n                            <h4 className=\"font-bold text-gray-900 dark:text-gray-100 text-sm line-clamp-1\">{item.title}</h4>\n                            <div className=\"text-xs text-gray-500 dark:text-gray-400 mt-1\">\n                              {item.price ? `${item.price.toLocaleString(\'fa-IR\')} \330\252\331\210\331\205\330\247\331\206` : \'\'}\n                            </div>\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n\n                    <div className=\"flex flex-wrap items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-800 gap-3 print:hidden\">\n                      <div className=\"text-xs text-gray-500 dark:text-gray-400\">\n                        {order.recipient?.address ? `\330\252\330\255\331\210\333\214\331\204 \330\250\331\207: ${order.recipient.name} - ${order.recipient.address}` : \'\'}\n                      </div>\n\n                      <div className=\"flex items-center gap-2 mr-auto\">\n                        {order.status === \'processing\' && (\n                          <button \n                            onClick={() => handleCancelOrder(order.id)}\n                            className=\"text-xs text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 px-3 py-2 rounded-lg font-medium transition-colors border border-red-200 dark:border-red-800\"\n                          >\n                            \331\204\330\272\331\210 \330\263\331\201\330\247\330\261\330\264\n                          </button>\n                        )}\n                        <button \n                          onClick={() => handlePrint(order.id)}\n                          className=\"text-gray-600 dark:text-gray-300 hover:text-orange-600 font-medium text-xs sm:text-sm flex items-center gap-1.5 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 px-3.5 py-2 rounded-xl transition-colors\"\n                        >\n                          <Printer className=\"h-4 w-4\" /> \332\206\330\247\331\276 \331\201\330\247\332\251\330\252\331\210\330\261\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              ))\n            )}\n          </div>\n        </div>\n      </div>\n    </motion.div>\n  );\n}\n"
    }
