      target_content: "    <nav\n      aria-label=\"\331\205\330\263\333\214\330\261 \330\261\330\247\331\207\331\206\331\205\330\247\"\n      className=\"flex items-center gap-1.5 text-xs sm:text-sm text-gray-500 dark:text-gray-400 mb-6 overflow-x-auto whitespace-nowrap hide-scrollbar print:hidden dir-rtl py-1\"\n    >\n      {items.map((item, index) => {\n        const isLast = index === items.length - 1;\n\n        return (\n          <React.Fragment key={index}>\n            {index === 0 ? (\n              <Link\n                to={item.href || \'/\'}\n                className=\"inline-flex items-center gap-1 text-gray-500 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition-colors\"\n                title=\"\330\256\330\247\331\206\331\207\"\n              >\n                <Home className=\"h-3.5 w-3.5\" />\n                <span>{item.label}</span>\n              </Link>\n            ) : item.href ? (\n              <Link\n                to={item.href}\n                className=\"hover:text-orange-600 dark:hover:text-orange-400 transition-colors font-medium text-gray-600 dark:text-gray-300\"\n              >\n                {item.label}\n              </Link>\n            ) : (\n              <span\n                aria-current=\"page\"\n                className=\"text-gray-900 dark:text-gray-100 font-bold truncate max-w-[200px] sm:max-w-[350px]\"\n                title={item.label}\n              >\n                {item.label}\n              </span>\n            )}\n\n            {!isLast && (\n              <ChevronLeft className=\"h-3.5 w-3.5 text-gray-400 dark:text-gray-600 shrink-0 mx-0.5\" />\n            )}\n          </React.Fragment>\n        );\n      })}\n    </nav>"
