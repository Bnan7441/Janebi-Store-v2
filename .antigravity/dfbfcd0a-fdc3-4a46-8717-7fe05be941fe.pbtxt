      original_chunk {
        target_content: "import React from \'react\';\n\nexport function ProductCardSkeleton() {\n  return (\n    <div className=\"bg-white rounded-2xl border border-gray-100 p-4 relative flex flex-col h-full\">\n      <div className=\"aspect-square w-full relative overflow-hidden rounded-xl bg-gray-200 animate-pulse mb-4\"></div>\n      \n      <div className=\"flex-grow flex flex-col\">\n        <div className=\"h-4 bg-gray-200 rounded w-3/4 mb-2 animate-pulse\"></div>\n        <div className=\"h-4 bg-gray-200 rounded w-1/2 mb-4 animate-pulse\"></div>\n        \n        <div className=\"mt-auto flex flex-col items-end w-full\">\n           <div className=\"h-3 bg-gray-200 rounded w-1/4 mb-1 animate-pulse\"></div>\n           <div className=\"h-6 bg-gray-200 rounded w-1/3 animate-pulse\"></div>\n        </div>\n      </div>\n      \n      <div className=\"w-full mt-4 h-10 bg-gray-200 rounded-xl animate-pulse\"></div>\n    </div>\n  );\n}\n\nexport function ProductDetailSkeleton() {\n  return (\n    <div className=\"bg-white rounded-3xl p-6 shadow-sm\">\n      <div className=\"h-4 bg-gray-200 rounded w-1/4 mb-8 animate-pulse\"></div>\n\n      <div className=\"flex flex-col lg:flex-row gap-12\">\n        <div className=\"w-full lg:w-5/12\">\n          <div className=\"aspect-square bg-gray-200 rounded-2xl mb-4 animate-pulse\"></div>\n          <div className=\"flex gap-4 overflow-x-auto\">\n             {[1, 2, 3].map(i => (\n               <div key={i} className=\"w-20 h-20 bg-gray-200 rounded-xl flex-shrink-0 animate-pulse\"></div>\n             ))}\n          </div>\n        </div>\n\n        <div className=\"w-full lg:w-7/12 flex flex-col\">\n          <div className=\"h-8 bg-gray-200 rounded w-3/4 mb-4 animate-pulse\"></div>\n          \n          <div className=\"flex gap-4 mb-6 pb-6 border-b border-gray-100\">\n            <div className=\"h-4 bg-gray-200 rounded w-1/4 animate-pulse\"></div>\n            <div className=\"h-4 bg-gray-200 rounded w-1/4 animate-pulse\"></div>\n          </div>\n\n          <div className=\"mb-8 flex flex-col items-end\">\n            <div className=\"h-4 bg-gray-200 rounded w-1/5 mb-2 animate-pulse\"></div>\n            <div className=\"h-8 bg-gray-200 rounded w-1/3 animate-pulse\"></div>\n          </div>\n\n          <div className=\"space-y-4 mb-8\">\n            <div className=\"h-14 bg-gray-200 rounded-xl animate-pulse\"></div>\n            <div className=\"h-14 bg-gray-200 rounded-xl animate-pulse\"></div>\n          </div>\n\n          <div className=\"mt-auto flex gap-4\">\n             <div className=\"flex-1 h-14 bg-gray-200 rounded-xl animate-pulse\"></div>\n             <div className=\"w-14 h-14 bg-gray-200 rounded-xl animate-pulse\"></div>\n             <div className=\"w-14 h-14 bg-gray-200 rounded-xl animate-pulse\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
        replacement_content: "import React from \'react\';\n\n/**\n * Skeleton Loader for Product Cards (Home, Products, Offers, New Products, etc.)\n */\nexport function ProductCardSkeleton() {\n  return (\n    <div className=\"bg-white dark:bg-gray-900 rounded-3xl border border-gray-100 dark:border-gray-800 p-4 relative flex flex-col h-full shadow-xs transition-colors\">\n      {/* Image Skeleton */}\n      <div className=\"aspect-square w-full relative overflow-hidden rounded-2xl bg-gray-200 dark:bg-gray-800 animate-pulse mb-4\">\n        <div className=\"absolute top-3 right-3 w-12 h-5 bg-gray-300 dark:bg-gray-700 rounded-md\"></div>\n      </div>\n\n      {/* Details Skeleton */}\n      <div className=\"flex-grow flex flex-col justify-between\">\n        <div className=\"space-y-2\">\n          {/* Brand badge */}\n          <div className=\"h-3 bg-gray-200 dark:bg-gray-800 rounded-md w-1/3 animate-pulse\"></div>\n          {/* Title lines */}\n          <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-full animate-pulse\"></div>\n          <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-2/3 animate-pulse\"></div>\n        </div>\n\n        {/* Rating and Price Skeleton */}\n        <div className=\"mt-4 pt-3 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between\">\n          <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-16 animate-pulse\"></div>\n          <div className=\"flex flex-col items-end gap-1\">\n            <div className=\"h-3 bg-gray-200 dark:bg-gray-800 rounded-md w-12 animate-pulse\"></div>\n            <div className=\"h-5 bg-gray-200 dark:bg-gray-800 rounded-md w-20 animate-pulse\"></div>\n          </div>\n        </div>\n      </div>\n\n      {/* Button Skeleton */}\n      <div className=\"w-full mt-4 h-10 bg-gray-200 dark:bg-gray-800 rounded-xl animate-pulse\"></div>\n    </div>\n  );\n}\n\n/**\n * Skeleton Loader for Product Detail Page\n */\nexport function ProductDetailSkeleton() {\n  return (\n    <div className=\"bg-white dark:bg-gray-900 rounded-3xl p-6 lg:p-10 shadow-sm border border-gray-100 dark:border-gray-800 space-y-8 animate-pulse\">\n      {/* Breadcrumb Skeleton */}\n      <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-1/3 mb-6\"></div>\n\n      <div className=\"flex flex-col lg:flex-row gap-12 lg:gap-16\">\n        {/* Left Gallery Skeleton */}\n        <div className=\"w-full lg:w-5/12 space-y-4\">\n          <div className=\"aspect-square bg-gray-200 dark:bg-gray-800 rounded-3xl w-full\"></div>\n          <div className=\"flex gap-3\">\n            {[1, 2, 3].map(i => (\n              <div key={i} className=\"w-20 h-20 bg-gray-200 dark:bg-gray-800 rounded-2xl shrink-0\"></div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right Info Skeleton */}\n        <div className=\"w-full lg:w-7/12 flex flex-col justify-between space-y-6\">\n          <div className=\"space-y-3\">\n            <div className=\"h-8 bg-gray-200 dark:bg-gray-800 rounded-xl w-3/4\"></div>\n            <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-lg w-1/2\"></div>\n          </div>\n\n          <div className=\"flex gap-4 py-4 border-y border-gray-100 dark:border-gray-800\">\n            <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-24\"></div>\n            <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-24\"></div>\n          </div>\n\n          <div className=\"flex flex-col items-end space-y-2\">\n            <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-20\"></div>\n            <div className=\"h-8 bg-gray-200 dark:bg-gray-800 rounded-xl w-32\"></div>\n          </div>\n\n          <div className=\"space-y-3\">\n            <div className=\"h-12 bg-gray-200 dark:bg-gray-800 rounded-xl\"></div>\n            <div className=\"h-12 bg-gray-200 dark:bg-gray-800 rounded-xl\"></div>\n          </div>\n\n          <div className=\"flex gap-4 pt-4\">\n            <div className=\"flex-1 h-14 bg-gray-200 dark:bg-gray-800 rounded-xl\"></div>\n            <div className=\"w-14 h-14 bg-gray-200 dark:bg-gray-800 rounded-xl\"></div>\n            <div className=\"w-14 h-14 bg-gray-200 dark:bg-gray-800 rounded-xl\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/**\n * Skeleton Loader for Live Search Dropdown Items\n */\nexport function SearchItemSkeleton() {\n  return (\n    <div className=\"p-2.5 rounded-2xl border border-transparent flex items-center justify-between animate-pulse\">\n      <div className=\"flex items-center gap-3.5 w-full\">\n        <div className=\"w-12 h-12 bg-gray-200 dark:bg-gray-800 rounded-xl shrink-0\"></div>\n        <div className=\"space-y-2 flex-1\">\n          <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-3/4\"></div>\n          <div className=\"h-3 bg-gray-200 dark:bg-gray-800 rounded-md w-1/2\"></div>\n        </div>\n      </div>\n      <div className=\"w-16 h-5 bg-gray-200 dark:bg-gray-800 rounded-md shrink-0\"></div>\n    </div>\n  );\n}\n\n/**\n * Skeleton Loader for Category Grid Badges/Cards\n */\nexport function CategoryCardSkeleton() {\n  return (\n    <div className=\"bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 p-4 sm:p-5 flex flex-col items-center justify-center animate-pulse\">\n      <div className=\"w-12 h-12 bg-gray-200 dark:bg-gray-800 rounded-2xl mb-3\"></div>\n      <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-16\"></div>\n    </div>\n  );\n}\n\n/**\n * Skeleton Loader for Brand Cards\n */\nexport function BrandCardSkeleton() {\n  return (\n    <div className=\"border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 rounded-2xl p-6 flex flex-col items-center justify-center h-28 animate-pulse\">\n      <div className=\"w-24 h-8 bg-gray-200 dark:bg-gray-800 rounded-lg mb-2\"></div>\n      <div className=\"w-12 h-3 bg-gray-200 dark:bg-gray-800 rounded-md\"></div>\n    </div>\n  );\n}\n\n/**\n * Skeleton Loader for Order History Items\n */\nexport function OrderCardSkeleton() {\n  return (\n    <div className=\"bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden animate-pulse\">\n      <div className=\"bg-gray-50 dark:bg-gray-800/50 p-4 sm:p-6 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between\">\n        <div className=\"flex gap-6\">\n          <div className=\"w-20 h-8 bg-gray-200 dark:bg-gray-700 rounded-lg\"></div>\n          <div className=\"w-20 h-8 bg-gray-200 dark:bg-gray-700 rounded-lg\"></div>\n          <div className=\"w-24 h-8 bg-gray-200 dark:bg-gray-700 rounded-lg\"></div>\n        </div>\n        <div className=\"w-24 h-7 bg-gray-200 dark:bg-gray-700 rounded-lg\"></div>\n      </div>\n      <div className=\"p-4 sm:p-6 space-y-4\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-16 h-16 bg-gray-200 dark:bg-gray-800 rounded-xl\"></div>\n          <div className=\"space-y-2 flex-1\">\n            <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-1/2\"></div>\n            <div className=\"h-3 bg-gray-200 dark:bg-gray-800 rounded-md w-1/4\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/**\n * Skeleton Loader for Reviews List\n */\nexport function ReviewSkeleton() {\n  return (\n    <div className=\"bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 sm:p-6 space-y-3 animate-pulse\">\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-800\"></div>\n          <div className=\"space-y-1.5\">\n            <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-28\"></div>\n            <div className=\"h-3 bg-gray-200 dark:bg-gray-800 rounded-md w-16\"></div>\n          </div>\n        </div>\n        <div className=\"w-12 h-6 bg-gray-200 dark:bg-gray-800 rounded-xl\"></div>\n      </div>\n      <div className=\"h-4 bg-gray-200 dark:bg-gray-800 rounded-md w-1/3\"></div>\n      <div className=\"h-10 bg-gray-200 dark:bg-gray-800 rounded-md w-full\"></div>\n    </div>\n  );\n}\n"
