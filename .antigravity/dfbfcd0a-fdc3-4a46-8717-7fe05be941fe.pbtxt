      target_content: "export default function Footer() {\n  const [email, setEmail] = useState(\'\');\n  const { addToast } = useToast();\n\n  const handleSubscribe = (e: React.FormEvent) => {\n    e.preventDefault();\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (!emailRegex.test(email)) {\n      addToast(\'\331\204\330\267\331\201\330\247 \333\214\332\251 \330\242\330\257\330\261\330\263 \330\247\333\214\331\205\333\214\331\204 \331\205\330\271\330\252\330\250\330\261 \331\210\330\247\330\261\330\257 \332\251\331\206\333\214\330\257\', \'error\');\n      return;\n    }\n    \n    if (email.trim()) {\n      addToast(\'\330\250\330\247 \331\205\331\210\331\201\331\202\333\214\330\252 \330\257\330\261 \330\256\330\250\330\261\331\206\330\247\331\205\331\207 \330\271\330\266\331\210 \330\264\330\257\333\214\330\257\', \'success\');\n      setEmail(\'\');\n    }\n  };\n\n  return (\n    <footer className=\"bg-white border-t border-gray-200 mt-12\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12 border-b border-gray-100 pb-12\">\n          <div className=\"flex items-center gap-4 justify-center md:justify-start\">\n            <Truck className=\"h-10 w-10 text-gray-700\" strokeWidth={1.5} />\n            <div>\n              <h4 className=\"font-bold text-gray-900 text-sm mb-1\">\330\247\330\261\330\263\330\247\331\204 \330\263\330\261\333\214\330\271</h4>\n              <p className=\"text-xs text-gray-500\">\330\247\330\261\330\263\330\247\331\204 \330\257\330\261 \330\263\330\261\333\214\330\271\342\200\214\330\252\330\261\333\214\331\206 \330\262\331\205\330\247\331\206</p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4 justify-center md:justify-start\">\n            <HeadphonesIcon className=\"h-10 w-10 text-gray-700\" strokeWidth={1.5} />\n            <div>\n              <h4 className=\"font-bold text-gray-900 text-sm mb-1\">\331\276\330\264\330\252\333\214\330\250\330\247\331\206\333\214 \330\252\330\256\330\265\330\265\333\214</h4>\n              <p className=\"text-xs text-gray-500\">\331\276\330\247\330\263\330\256\342\200\214\332\257\331\210\333\214\333\214 \333\271 \330\265\330\250\330\255 \330\252\330\247 \333\271 \330\264\330\250</p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4 justify-center md:justify-start\">\n            <Shield className=\"h-10 w-10 text-gray-700\" strokeWidth={1.5} />\n            <div>\n              <h4 className=\"font-bold text-gray-900 text-sm mb-1\">\333\267 \330\261\331\210\330\262 \330\266\331\205\330\247\331\206\330\252 \330\250\330\247\330\262\332\257\330\264\330\252 \332\251\330\247\331\204\330\247</h4>\n              <p className=\"text-xs text-gray-500\">\330\250\330\247\330\262\332\257\330\264\330\252 \330\250\330\257\331\210\331\206 \331\202\333\214\330\257 \331\210 \330\264\330\261\330\267</p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4 justify-center md:justify-start\">\n            <CheckCircle className=\"h-10 w-10 text-gray-700\" strokeWidth={1.5} />\n            <div>\n              <h4 className=\"font-bold text-gray-900 text-sm mb-1\">\330\266\331\205\330\247\331\206\330\252 \330\247\330\265\330\247\331\204\330\252 \332\251\330\247\331\204\330\247</h4>\n              <p className=\"text-xs text-gray-500\">\330\252\330\266\331\205\333\214\331\206 \330\247\330\265\330\247\331\204\330\252 \330\252\331\205\330\247\331\205 \331\205\330\255\330\265\331\210\331\204\330\247\330\252</p>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"flex flex-col md:flex-row items-center justify-between gap-8 mb-8\">\n           <div className=\"text-right\">\n              <h4 className=\"text-lg font-bold text-gray-900 mb-2\">\330\271\330\266\331\210\333\214\330\252 \330\257\330\261 \330\256\330\250\330\261\331\206\330\247\331\205\331\207</h4>\n              <p className=\"text-sm text-gray-500\">\330\247\330\262 \330\254\330\257\333\214\330\257\330\252\330\261\333\214\331\206 \330\252\330\256\331\201\333\214\331\201\342\200\214\331\207\330\247 \331\210 \331\205\330\255\330\265\331\210\331\204\330\247\330\252 \330\250\330\247\330\256\330\250\330\261 \330\264\331\210\333\214\330\257</p>\n           </div>\n           <form onSubmit={handleSubscribe} className=\"flex w-full md:w-auto max-w-md\">\n              <input \n                type=\"email\" \n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                placeholder=\"\330\242\330\257\330\261\330\263 \330\247\333\214\331\205\333\214\331\204 \330\264\331\205\330\247\" \n                className=\"flex-grow bg-gray-50 border border-gray-200 rounded-r-xl px-4 py-3 focus:outline-none focus:border-orange-500 text-left dir-ltr text-sm\"\n                required\n              />\n              <button type=\"submit\" className=\"bg-orange-600 hover:bg-orange-700 text-white px-6 rounded-l-xl flex items-center justify-center transition-colors\">\n                 <Send className=\"h-4 w-4\" />\n              </button>\n           </form>\n        </div>\n\n        <div className=\"text-center text-sm text-gray-500 pt-8 border-t border-gray-100\">\n          \330\252\331\205\330\247\331\205\333\214 \330\255\331\202\331\210\331\202 \330\247\333\214\331\206 \330\263\330\247\333\214\330\252 \331\205\330\252\330\271\331\204\331\202 \330\250\331\207 \331\201\330\261\331\210\330\264\332\257\330\247\331\207 \330\254\330\247\331\206\330\250\333\214 \330\242\330\261\331\206\330\247 \331\205\333\214\342\200\214\330\250\330\247\330\264\330\257.\n        </div>\n      </div>\n    </footer>\n  );\n}"
      replacement_content: "export default function Footer() {\n  const [email, setEmail] = useState(\'\');\n  const { addToast } = useToast();\n\n  const handleSubscribe = (e: React.FormEvent) => {\n    e.preventDefault();\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (!emailRegex.test(email)) {\n      addToast(\'\331\204\330\267\331\201\330\247 \333\214\332\251 \330\242\330\257\330\261\330\263 \330\247\333\214\331\205\333\214\331\204 \331\205\330\271\330\252\330\250\330\261 \331\210\330\247\330\261\330\257 \332\251\331\206\333\214\330\257\', \'error\');\n      return;\n    }\n    \n    if (email.trim()) {\n      addToast(\'\330\250\330\247 \331\205\331\210\331\201\331\202\333\214\330\252 \330\257\330\261 \330\256\330\250\330\261\331\206\330\247\331\205\331\207 \330\271\330\266\331\210 \330\264\330\257\333\214\330\257\', \'success\');\n      setEmail(\'\');\n    }\n  };\n\n  return (\n    <footer className=\"bg-white dark:bg-gray-900 border-t border-gray-200/80 dark:border-gray-800 mt-16 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\">\n        {/* Value Propositions */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-6 mb-12 border-b border-gray-100 dark:border-gray-800 pb-12\">\n          <div className=\"flex items-center gap-3.5 p-3 rounded-2xl bg-gray-50/80 dark:bg-gray-800/40 border border-gray-100/80 dark:border-gray-800\">\n            <div className=\"p-2.5 rounded-xl bg-orange-100/80 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 shrink-0\">\n              <Truck className=\"h-6 w-6\" strokeWidth={2} />\n            </div>\n            <div>\n              <h4 className=\"font-bold text-gray-900 dark:text-gray-100 text-xs sm:text-sm mb-0.5\">\330\247\330\261\330\263\330\247\331\204 \330\263\330\261\333\214\330\271 \331\210 \330\261\330\247\333\214\332\257\330\247\331\206</h4>\n              <p className=\"text-[11px] text-gray-500 dark:text-gray-400\">\330\263\331\201\330\247\330\261\330\264\342\200\214\331\207\330\247\333\214 \330\250\330\247\331\204\330\247\333\214 \333\267\333\265\333\260 \331\207\330\262\330\247\330\261 \330\252\331\210\331\205\330\247\331\206</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3.5 p-3 rounded-2xl bg-gray-50/80 dark:bg-gray-800/40 border border-gray-100/80 dark:border-gray-800\">\n            <div className=\"p-2.5 rounded-xl bg-blue-100/80 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 shrink-0\">\n              <HeadphonesIcon className=\"h-6 w-6\" strokeWidth={2} />\n            </div>\n            <div>\n              <h4 className=\"font-bold text-gray-900 dark:text-gray-100 text-xs sm:text-sm mb-0.5\">\331\276\330\264\330\252\333\214\330\250\330\247\331\206\333\214 \330\252\330\256\330\265\330\265\333\214</h4>\n              <p className=\"text-[11px] text-gray-500 dark:text-gray-400\">\333\267 \330\261\331\210\330\262 \331\207\331\201\330\252\331\207\330\214 \333\271 \330\265\330\250\330\255 \330\252\330\247 \333\271 \330\264\330\250</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3.5 p-3 rounded-2xl bg-gray-50/80 dark:bg-gray-800/40 border border-gray-100/80 dark:border-gray-800\">\n            <div className=\"p-2.5 rounded-xl bg-emerald-100/80 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 shrink-0\">\n              <Shield className=\"h-6 w-6\" strokeWidth={2} />\n            </div>\n            <div>\n              <h4 className=\"font-bold text-gray-900 dark:text-gray-100 text-xs sm:text-sm mb-0.5\">\333\267 \330\261\331\210\330\262 \330\266\331\205\330\247\331\206\330\252 \330\250\330\247\330\262\332\257\330\264\330\252</h4>\n              <p className=\"text-[11px] text-gray-500 dark:text-gray-400\">\330\252\330\266\331\205\333\214\331\206 \330\263\331\204\330\247\331\205\330\252 \331\201\331\206\333\214 \332\251\330\247\331\204\330\247</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3.5 p-3 rounded-2xl bg-gray-50/80 dark:bg-gray-800/40 border border-gray-100/80 dark:border-gray-800\">\n            <div className=\"p-2.5 rounded-xl bg-amber-100/80 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 shrink-0\">\n              <CheckCircle className=\"h-6 w-6\" strokeWidth={2} />\n            </div>\n            <div>\n              <h4 className=\"font-bold text-gray-900 dark:text-gray-100 text-xs sm:text-sm mb-0.5\">\330\266\331\205\330\247\331\206\330\252 \330\247\330\265\330\247\331\204\330\252 \332\251\330\247\331\204\330\247</h4>\n              <p className=\"text-[11px] text-gray-500 dark:text-gray-400\">\333\261\333\260\333\260\331\252 \330\247\331\210\330\261\330\254\333\214\331\206\330\247\331\204 \330\250\330\247 \332\257\330\247\330\261\330\247\331\206\330\252\333\214 \331\205\330\271\330\252\330\250\330\261</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Newsletter Section */}\n        <div className=\"flex flex-col md:flex-row items-center justify-between gap-6 mb-10 bg-gradient-to-r from-orange-50 to-amber-50 dark:from-gray-800/80 dark:to-gray-800/40 p-6 rounded-2xl border border-orange-100/80 dark:border-gray-700/60\">\n           <div className=\"text-right\">\n              <h4 className=\"text-base sm:text-lg font-black text-gray-900 dark:text-gray-100 mb-1\">\330\271\330\266\331\210\333\214\330\252 \330\257\330\261 \330\256\330\250\330\261\331\206\330\247\331\205\331\207 \330\254\330\247\331\206\330\250\333\214 \330\242\330\261\331\206\330\247</h4>\n              <p className=\"text-xs sm:text-sm text-gray-600 dark:text-gray-300\">\330\247\330\262 \330\254\330\257\333\214\330\257\330\252\330\261\333\214\331\206 \330\252\330\256\331\201\333\214\331\201\342\200\214\331\207\330\247 \331\210 \332\251\330\257\331\207\330\247\333\214 \330\252\330\256\331\201\333\214\331\201 \331\210\333\214\332\230\331\207 \330\250\330\247\330\256\330\250\330\261 \330\264\331\210\333\214\330\257</p>\n           </div>\n           <form onSubmit={handleSubscribe} className=\"flex w-full md:w-auto max-w-md\">\n              <input \n                type=\"email\" \n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                placeholder=\"\330\242\330\257\330\261\330\263 \330\247\333\214\331\205\333\214\331\204 \330\264\331\205\330\247...\" \n                className=\"flex-grow bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-r-xl px-4 py-3 focus:outline-none focus:border-orange-500 dark:focus:border-orange-400 text-left dir-ltr text-sm text-gray-800 dark:text-gray-200 placeholder:text-gray-400 dark:placeholder:text-gray-500\"\n                required\n              />\n              <button type=\"submit\" className=\"bg-orange-600 hover:bg-orange-700 dark:bg-orange-500 dark:hover:bg-orange-600 text-white px-5 rounded-l-xl flex items-center justify-center transition-colors font-medium\">\n                 <Send className=\"h-4 w-4\" />\n              </button>\n           </form>\n        </div>\n\n        <div className=\"text-center text-xs text-gray-500 dark:text-gray-400 pt-6 border-t border-gray-100 dark:border-gray-800\">\n          \330\252\331\205\330\247\331\205\333\214 \330\255\331\202\331\210\331\202 \331\205\330\247\330\257\333\214 \331\210 \331\205\330\271\331\206\331\210\333\214 \330\247\333\214\331\206 \330\263\330\247\333\214\330\252 \331\205\330\252\330\271\331\204\331\202 \330\250\331\207 \331\201\330\261\331\210\330\264\332\257\330\247\331\207 \330\242\331\206\331\204\330\247\333\214\331\206 <span className=\"font-bold text-gray-700 dark:text-gray-300\">\330\254\330\247\331\206\330\250\333\214 \330\242\330\261\331\206\330\247</span> \331\205\333\214\342\200\214\330\250\330\247\330\264\330\257.\n        </div>\n      </div>\n    </footer>\n  );\n}"
