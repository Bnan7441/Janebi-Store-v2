    modified_response: "\330\250\330\256\330\264 \332\251\331\204\333\214\330\257\342\200\214\331\207\330\247\333\214 \332\251\331\206\330\252\330\261\331\204\333\214 \331\210 \330\257\330\263\330\252\330\261\330\263\333\214 \330\263\330\261\333\214\330\271 \331\207\330\257\330\261 (\330\263\331\201\330\247\330\261\330\264\333\214\342\200\214\330\263\330\247\330\262\333\214 \330\250\330\261 \330\247\330\263\330\247\330\263 \330\271\331\206\330\265\330\261 \330\247\331\206\330\252\330\256\330\247\330\250\342\200\214\330\264\330\257\331\207) \330\250\330\247 \331\210\333\214\332\230\332\257\333\214\342\200\214\331\207\330\247\333\214 \330\262\333\214\330\261 \330\250\330\247\330\262\330\267\330\261\330\247\330\255\333\214 \330\264\330\257:\n\n- **\330\242\333\214\332\251\331\210\331\206\342\200\214\331\207\330\247\333\214 \331\205\330\257\330\261\331\206 \331\210 \331\207\331\205\330\247\331\207\331\206\332\257**: \330\254\330\247\333\214\332\257\330\262\333\214\331\206\333\214 \330\247\333\214\331\205\331\210\330\254\333\214 \331\205\330\252\331\206\333\214 \330\250\330\247 \330\242\333\214\332\251\331\210\331\206\342\200\214\331\207\330\247\333\214 \330\250\330\261\330\257\330\247\330\261\333\214 Lucide (`ArrowLeftRight` \330\250\330\261\330\247\333\214 \331\205\331\202\330\247\333\214\330\263\331\207\330\214 `Heart` \330\250\330\261\330\247\333\214 \330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247\330\214 `User` \330\250\330\261\330\247\333\214 \330\255\330\263\330\247\330\250 \332\251\330\247\330\261\330\250\330\261\333\214\330\214 \331\210 `Moon`/`Sun` \330\250\330\261\330\247\333\214 \330\255\330\247\331\204\330\252 \330\264\330\250/\330\261\331\210\330\262).\n- **\330\257\332\251\331\205\331\207\342\200\214\331\207\330\247\333\214 \330\252\330\271\330\247\331\205\331\204\333\214 \331\210 \332\251\330\247\330\261\330\252\342\200\214\331\207\330\247\333\214 \332\251\331\210\332\206\332\251**: \330\267\330\261\330\247\330\255\333\214 \332\251\331\204\333\214\330\257\331\207\330\247 \330\250\331\207\342\200\214\330\265\331\210\330\261\330\252 \331\276\330\257\333\214\330\257\331\207 \330\264\331\206\330\247\331\210\330\261 (Glassmorphism / Soft Cards) \330\250\330\247 \330\247\331\201\332\251\330\252\342\200\214\331\207\330\247\333\214 \330\247\331\206\333\214\331\205\333\214\330\264\331\206\333\214 \331\207\331\206\332\257\330\247\331\205 Hover \331\210 \331\276\330\264\330\252\333\214\330\250\330\247\331\206\333\214 \332\251\330\247\331\205\331\204 \330\247\330\262 \330\255\330\247\331\204\330\252 \330\252\330\247\330\261\333\214\332\251 (Dark Mode).\n- **\331\206\330\264\330\247\331\206\332\257\330\261\331\207\330\247\333\214 \331\276\331\210\333\214\330\247 (Badges)**: \330\247\331\201\330\262\331\210\330\257\331\206 \331\206\330\264\330\247\331\206\332\257\330\261\331\207\330\247\333\214 \330\247\331\206\333\214\331\205\333\214\330\264\331\206\333\214 \330\264\331\205\330\247\330\261\330\264 \332\251\330\247\331\204\330\247\331\207\330\247 \330\250\330\261\330\247\333\214 \331\204\333\214\330\263\330\252 \330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247\330\214 \331\205\331\202\330\247\333\214\330\263\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252 \331\210 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257.\n- **\330\257\332\251\331\205\331\207 \330\250\330\261\330\254\330\263\330\252\331\207 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257**: \330\267\330\261\330\247\330\255\333\214 \330\257\332\251\331\205\331\207 \330\263\330\250\330\257 \330\256\330\261\333\214\330\257 \330\250\331\207 \330\264\332\251\331\204 \330\257\332\251\331\205\331\207 \330\247\331\202\330\257\330\247\331\205 \330\247\330\265\331\204\333\214 (CTA) \330\250\330\247 \332\257\330\261\330\247\330\257\333\214\331\206\330\252 \332\257\330\261\331\205 \331\206\330\247\330\261\331\206\330\254\3