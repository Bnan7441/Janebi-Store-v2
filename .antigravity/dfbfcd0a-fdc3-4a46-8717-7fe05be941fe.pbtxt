        target_content: "          {/* Actions */}\n          <div className=\"flex items-center gap-4 md:gap-6\">\n            <button onClick={toggleTheme} className=\"flex flex-col items-center text-gray-600 hover:text-orange-600 transition-colors hidden sm:flex\">\n              {isDarkMode ? <Sun className=\"h-6 w-6\" /> : <Moon className=\"h-6 w-6\" />}\n              <span className=\"text-xs mt-1\">{isDarkMode ? \'\330\261\331\210\330\262\' : \'\330\264\330\250\'}</span>\n            </button>\n            <Link to=\"/profile\" className=\"flex flex-col items-center text-gray-600 hover:text-orange-600 transition-colors hidden sm:flex\">\n              <User className=\"h-6 w-6\" />\n              <span className=\"text-xs mt-1\">\330\255\330\263\330\247\330\250 \332\251\330\247\330\261\330\250\330\261\333\214</span>\n            </Link>\n            <Link to=\"/compare\" className=\"flex flex-col items-center text-gray-600 hover:text-orange-600 transition-colors hidden sm:flex relative\">\n              <div className=\"relative text-xl\">\n                 \342\232\226\357\270\217\n              </div>\n              <span className=\"text-xs mt-1\">\331\205\331\202\330\247\333\214\330\263\331\207</span>\n            </Link>\n            <Link to=\"/wishlist\" className=\"flex flex-col items-center text-gray-600 hover:text-orange-600 transition-colors relative\">\n              <div className=\"relative\">\n                <Heart className=\"h-6 w-6\" />\n                {wishlist.length > 0 && (\n                   <span className=\"absolute -top-2 -right-2 bg-orange-600 text-white text-[10px] font-bold h-4 w-4 rounded-full flex items-center justify-center\">{wishlist.length}</span>\n                )}\n              </div>\n              <span className=\"text-xs mt-1 hidden sm:block\">\330\271\331\204\330\247\331\202\331\207\342\200\214\331\205\331\206\330\257\333\214\342\200\214\331\207\330\247</span>\n            </Link>\n            <Link to=\"/cart\"