center text-center min-h-[260px]\">\n            <div className=\"flex gap-4 mb-4\">\n              <div className=\"p-4 bg-white dark:bg-gray-800 rounded-2xl shadow-sm text-orange-600 dark:text-orange-400 border border-gray-100 dark:border-gray-700\">\n                <Headphones className=\"h-8 w-8\" />\n              </div>\n              <div className=\"p-4 bg-white dark:bg-gray-800 rounded-2xl shadow-sm text-amber-600 dark:text-amber-400 border border-gray-100 dark:border-gray-700\">\n                <BatteryCharging className=\"h-8 w-8\" />\n              </div>\n              <div className=\"p-4 bg-white dark:bg-gray-800 rounded-2xl shadow-sm text-rose-600 dark:text-rose-400 border border-gray-100 dark:border-gray-700\">\n                <Smartphone className=\"h-8 w-8\" />\n              </div>\n            </div>\n            <p className=\"text-xs font-bold text-gray-700 dark:text-gray-300\">\330\250\333\214\330\264 \330\247\330\262 \333\265,\333\260\333\260\333\260 \331\204\331\210\330\247\330\262\331\205 \330\254\330\247\331\206\330\250\333\214 \330\247\331\210\330\261\330\254\333\214\331\206\330\247\331\204</p>\n            <p className=\"text-[11px] text-gray-500 dark:text-gray-400 mt-1\">\330\263\330\247\331\205\330\263\331\210\331\206\332\257\330\214 \330\242\333\214\331\201\331\210\331\206\330\214 \330\264\333\214\330\247\330\246\331\210\331\205\333\214\330\214 \330\247\331\206\332\251\330\261\330\214 \330\250\330\247\330\263\330\246\331\210\330\263 \331\210 ...</p>\n          </div>\n        </motion.div>\n      </motion.div>\n\n      {/* Categories */}\n      <section>\n        <div className=\"flex items-center justify-center mb-8 relative\">\n          <div className=\"absolute inset-0 flex items-center\" aria-hidden=\"true\">\n            <div className=\"w-full border-t border-gray-200/80 dark:border-gray-800\"></div>\n          </div>\n          <div className=\"relative bg-gray-50 dark:bg-gray-950 px-6 transition-colors duration-300\">\n            <h2 className=\"text-xl sm:text-2xl font-black text-gray-900 dark:text-gray-100 tracking-tight flex items-center gap-2\">\n              \330\257\330\263\330\252\331\207\342\200\214\330\250\331\206\330\257\333\214\342\200\214\331\207\330\247\333\214 \331\205\330\255\330\250\331\210\330\250\n            </h2>\n          </div>\n        </div>\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 sm:gap-4\">\n          {categories.map((cat, idx) => {\n            const CategoryIcon = cat.icon;\n            return (\n              <motion.div\n                initial={{ opacity: 0, y: 15 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ delay: idx * 0.08, duration: 0.4 }}\n                key={idx}\n              >\n                <Link to={`/products?category=${encodeURIComponent(cat.title)}`} className=\"bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 p-4 sm:p-5 flex flex-col items-center justify-center hover:shadow-lg dark:hover:shadow-black/30 hover:border-orange-200 dark:hover:border-gray-700 hover:-translate-y-1 transition-all duration-300 cursor-pointer group\">\n                  <div className={`rounded-2xl p-3.5 mb-3 bg-gradient-to-br ${cat.color} group-hover:scale-110 transition-transform duration-300`}>\n                    <CategoryIcon className=\"h-6 w-6\" />\n                  </div>\n                  <span className=\"text-xs sm:text-sm font-bold text-gray-800 dark:text-gray-200 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors\">{cat.title}</span>\n                </Link>\n              </motion.div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* Best Sellers */}\n      <section>\n         <div className=\"flex items-center justify-between mb-8\">\n           <h2 className=\"text-xl sm:text-2xl font-black text-gray-900 dark:text-gray-100 flex items-center gap-3 tracking-tight\">\n             <span className=\"w-2.5 h-8 bg-orange-600 dark:bg-orange-500 rounded-full shadow-sm\"></span>\n             \331\276\330\261\331\201\330\261\331\210\330\264\342\200\214\330\252\330\261\333\214\331\206 \331\205\330\255\330\265\331\210\331\204\330\247\330\252\n           </h2>\n           <Link to=\"/products\" className=\"text-xs sm:text-sm font-bold text-orange-600 dark:text-orange-400 hover:underline flex items-center gap-1\">\n             \331\205\330\264\330\247\331\207\330\257\331\207 \331\207\331\205\331\207 <ArrowLeft className=\"h-3.5 w-3.5\" />\n           </Link>\n         </div>\n         <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6\">\n            {loading ? (\n              Array.from({ length: 4 }).map((_, idx) => (\n                <ProductCardSkeleton key={idx} />\n              ))\n            ) : (\n              products.map((product: any) => (\n                <ProductCard key={product.id} product={product} />\n              ))\n            )}\n         </div>\n      </section>\n      \n      <Testimonials />\n      <RecentlyViewed title=\"\330\242\330\256\330\261\333\214\331\206 \330\250\330\247\330\262\330\257\333\214\330\257\331\207\330\247\333\214 \330\264\331\205\330\247\" limit={4} />\n      <FAQ />\n      </div>\n    </div>\n  );\n}"
