00 ${\n                openIndex === index ? \'max-h-40 pb-6 opacity-100\' : \'max-h-0 opacity-0\'\n              }`}\n            >\n              <div className=\"pt-3 border-t border-gray-100 dark:border-gray-800\">{faq.answer}</div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}"
