ed-2xl p-6 flex flex-col items-center justify-center hover:shadow-md hover:border-orange-200 dark:hover:border-gray-700 transition-all group\">\n              <span className=\"font-black text-lg text-gray-800 dark:text-gray-200 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors\">{brand.name}</span>\n              <span className=\"text-xs text-gray-400 mt-1\">\331\205\330\264\330\247\331\207\330\257\331\207 \331\205\330\255\330\265\331\210\331\204\330\247\330\252</span>\n            </Link>\n          ))\n        )}\n      </div>\n    </div>\n  );\n}"
