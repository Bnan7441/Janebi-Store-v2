# Server
PORT=3000
NODE_ENV=development

# Database (SQLite)
DATABASE_URL=data/janebi.db

# Authentication
JWT_ACCESS_SECRET="generate-a-strong-secret-key-here-for-access"
JWT_REFRESH_SECRET="generate-a-strong-secret-key-here-for-refresh"

# Payment (ZarinPal)
ZARINPAL_MERCHANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ZARINPAL_SANDBOX=true

# AI (Optional)
GEMINI_API_KEY=""

# App URL
APP_URL="http://localhost:3000"
